<% content_for :title, @product_category.new_record? ? "New Product Category" : "Edit Product Category" %>

<div class="p-6 max-w-2xl">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to product_categories_path, class: "text-gray-400 hover:text-gray-600 transition-colors", aria: { label: "Back to product categories" } do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
    <h1 class="text-xl font-semibold text-gray-900">
      <%= @product_category.new_record? ? "New Product Category" : "Edit — #{@product_category.name}" %>
    </h1>
  </div>

  <%= form_with model: @product_category, class: "space-y-6" do |f| %>
    <% if @product_category.errors.any? %>
      <div class="p-4 bg-red-50 border border-red-200 rounded-md" role="alert">
        <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
          <% @product_category.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
      <div>
        <%= f.label :name, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name,
                         autofocus: true,
                         class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>

    <div class="flex gap-3">
      <%= f.submit @product_category.new_record? ? "Create Product Category" : "Update Product Category",
                   class: "px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 cursor-pointer transition-colors" %>
      <%= link_to "Cancel", product_categories_path,
                  class: "px-5 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50 transition-colors" %>
    </div>
  <% end %>
</div>
