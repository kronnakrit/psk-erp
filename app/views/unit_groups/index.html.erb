<% content_for :title, "Unit Groups" %>

<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900">Unit Groups</h1>
    <% if policy(UnitGroup).create? %>
      <%= link_to "New Unit Group", new_unit_group_path,
                  class: "inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors" %>
    <% end %>
  </div>

  <div class="overflow-hidden border border-gray-200 rounded-lg">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Definitions</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @unit_groups.each do |group| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 font-medium text-gray-900"><%= link_to group.name, group, class: "hover:underline" %></td>
            <td class="px-4 py-3">
              <% if group.is_default? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                  Default
                </span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-gray-600">
              <%= pluralize(group.unit_definitions.size, "Unit") %>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-3">
                <% unless group.is_default? %>
                  <%= button_to "Set Default", set_default_unit_group_path(group), method: :patch,
                                class: "text-green-600 hover:underline text-xs bg-transparent border-none cursor-pointer p-0",
                                data: { turbo_confirm: "Set #{group.name} as the global default unit group?" } %>
                <% end %>
                
                <% if policy(group).update? %>
                  <%= link_to "Edit", edit_unit_group_path(group), class: "text-blue-600 hover:underline text-xs" %>
                <% end %>
                
                <% if policy(group).destroy? %>
                  <%= button_to "Delete", unit_group_path(group), method: :delete,
                                class: "text-red-600 hover:underline text-xs bg-transparent border-none cursor-pointer p-0",
                                data: { turbo_confirm: "Delete #{group.name}? This will remove all its units." } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @unit_groups.empty? %>
          <tr>
            <td colspan="4" class="px-4 py-8 text-center text-gray-400">No unit groups found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
