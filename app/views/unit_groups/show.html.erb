<% content_for :title, @unit_group.name %>

<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <%= link_to unit_groups_path, class: "text-gray-400 hover:text-gray-600" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      <% end %>
      <div class="flex items-center gap-4">
        <h1 class="text-xl font-semibold text-gray-900"><%= @unit_group.name %></h1>
        <% if @unit_group.is_default? %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
            Global Default
          </span>
        <% end %>
      </div>
    </div>
    
    <div class="flex items-center gap-3">
      <% if policy(@unit_group).update? %>
        <%= link_to "Edit", edit_unit_group_path(@unit_group),
                    class: "inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-50 transition-colors" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
      <div class="bg-white rounded-lg shadow border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Unit Definitions</h2>
        </div>
        
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Unit Name</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Ratio</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody id="unit_definitions_list" class="bg-white divide-y divide-gray-200">
              <% if @unit_group.unit_definitions.reject(&:new_record?).empty? %>
                <tr id="empty_unit_definitions">
                  <td colspan="3" class="px-6 py-8 text-center text-gray-400">No units defined yet.</td>
                </tr>
              <% else %>
                <%= render @unit_group.unit_definitions.reject(&:new_record?).sort_by(&:ratio) %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    
    <div class="lg:col-span-1">
      <% if policy(UnitDefinition.new).create? %>
        <div class="bg-white rounded-lg shadow border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
            <h2 class="text-lg font-medium text-gray-900">Add Unit</h2>
          </div>
          <div class="p-6">
            <%= render "unit_definitions/form", unit_group: @unit_group, unit_definition: @unit_definition %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
