<% content_for :title, @role.new_record? ? "New Role" : "Edit Role" %>

<div class="p-6 max-w-2xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900">
      <%= @role.new_record? ? "New Role" : "Edit Role — #{@role.name}" %>
    </h1>
    <%= link_to "← Back to Roles", roles_path, class: "text-sm text-blue-600 hover:underline" %>
  </div>

  <%= form_with model: @role, class: "space-y-6" do |f| %>
    <% if @role.errors.any? %>
      <div class="p-4 bg-red-50 border border-red-200 rounded-md">
        <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
          <% @role.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
      <div>
        <%= f.label :name, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <h2 class="text-sm font-semibold text-gray-700 mb-3">Permissions</h2>
      <div class="grid grid-cols-2 gap-2">
        <% @permissions.each do |perm| %>
          <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
            <%= check_box_tag "role[permissions][]", perm, @role.permissions.include?(perm),
                              id: "perm_#{perm}",
                              class: "h-4 w-4 text-blue-600 border-gray-300 rounded" %>
            <span class="font-mono text-xs"><%= perm %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="flex gap-3">
      <%= f.submit @role.new_record? ? "Create Role" : "Update Role",
                  class: "px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 cursor-pointer" %>
      <%= link_to "Cancel", roles_path, class: "px-5 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
