<% content_for :title, "Vendors" %>

<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900">Vendors</h1>
    <div class="flex items-center gap-2">
      <% if policy(Vendor).initialize_names? %>
        <%= button_to "Initialize Names", initialize_names_vendors_path,
                      method: :post,
                      class: "inline-flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200 transition-colors",
                      data: { turbo_confirm: "Set initial_name for all vendors missing one?" } %>
      <% end %>
      <% if policy(Vendor).create? %>
        <%= link_to "New Vendor", new_vendor_path,
                    class: "inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors" %>
      <% end %>
    </div>
  </div>

  <%= search_form_for @ransack, url: vendors_path do |f| %>
    <div class="flex gap-3 mb-4">
      <%= f.search_field :name_or_initial_name_or_remark_or_telephone_or_address_cont,
                         placeholder: "Search by name, initial name, telephone…",
                         class: "flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <%= f.submit "Search", class: "px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded-md hover:bg-gray-300" %>
      <%= link_to "Clear", vendors_path, class: "px-4 py-2 text-sm text-gray-500 hover:underline" %>
    </div>
  <% end %>

  <div class="overflow-hidden border border-gray-200 rounded-lg">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Initial Name</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Telephone</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Address</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @vendors.each do |vendor| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 font-medium text-gray-900"><%= vendor.name %></td>
            <td class="px-4 py-3 font-mono text-gray-600"><%= vendor.initial_name.presence || "—" %></td>
            <td class="px-4 py-3 text-gray-600"><%= vendor.telephone.presence || "—" %></td>
            <td class="px-4 py-3 text-gray-600 max-w-xs truncate"><%= vendor.address.presence || "—" %></td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <% if policy(vendor).update? %>
                  <%= link_to "Edit", edit_vendor_path(vendor), class: "text-blue-600 hover:underline text-xs" %>
                <% end %>
                <% if policy(vendor).destroy? %>
                  <%= button_to "Delete", vendor_path(vendor), method: :delete,
                                class: "text-red-600 hover:underline text-xs bg-transparent border-none cursor-pointer p-0",
                                data: { turbo_confirm: "Delete #{vendor.name}?" } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @vendors.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-gray-400">No vendors found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex items-center justify-between">
    <p class="text-sm text-gray-500">
      Showing <span class="font-medium text-gray-700"><%= @pagy.from %>–<%= @pagy.to %></span>
      of <span class="font-medium text-gray-700"><%= @pagy.count %></span>
    </p>
    <%== @pagy.series_nav if @pagy.pages > 1 %>
  </div>
</div>
