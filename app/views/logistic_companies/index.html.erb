<% content_for :title, "Logistic Companies" %>

<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900">Logistic Companies</h1>
    <% if policy(LogisticCompany).create? %>
      <%= link_to "New Logistic Company", new_logistic_company_path,
                  class: "inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors" %>
    <% end %>
  </div>

  <%= search_form_for @ransack, url: logistic_companies_path do |f| %>
    <div class="flex gap-3 mb-4">
      <%= f.search_field :name_or_address_or_remark_or_telephone_cont,
                         placeholder: "Search by name, address, remark or telephone…",
                         class: "flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <%= f.submit "Search", class: "px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded-md hover:bg-gray-300" %>
      <%= link_to "Clear", logistic_companies_path, class: "px-4 py-2 text-sm text-gray-500 hover:underline" %>
    </div>
  <% end %>

  <div class="overflow-hidden border border-gray-200 rounded-lg">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Telephone</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Address</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @logistic_companies.each do |lc| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-medium text-gray-900"><%= lc.name %></td>
            <td class="px-4 py-3 text-gray-600"><%= lc.telephone.presence || "—" %></td>
            <td class="px-4 py-3 text-gray-600 truncate max-w-xs"><%= lc.address.presence || "—" %></td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <% if policy(lc).update? %>
                  <%= link_to "Edit", edit_logistic_company_path(lc), class: "text-blue-600 hover:underline text-xs" %>
                <% end %>
                <% if policy(lc).destroy? %>
                  <%= button_to "Delete", logistic_company_path(lc), method: :delete,
                                class: "text-red-600 hover:underline text-xs bg-transparent border-none cursor-pointer p-0",
                                data: { turbo_confirm: "Delete #{lc.name}?" } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @logistic_companies.empty? %>
          <tr>
            <td colspan="4" class="px-4 py-8 text-center text-gray-400">No logistic companies found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex items-center justify-between">
    <p class="text-sm text-gray-500">
      Showing <span class="font-medium text-gray-700"><%= @pagy.from %>–<%= @pagy.to %></span>
      of <span class="font-medium text-gray-700"><%= @pagy.count %></span>
    </p>
    <%== @pagy.series_nav if @pagy.pages > 1 %>
  </div>
</div>
