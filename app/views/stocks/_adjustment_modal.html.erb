<%
  input_class = "w-full px-3 py-2.5 border border-gray-300 rounded-md text-sm shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 disabled:bg-gray-50 disabled:text-gray-500"
  btn_secondary = "inline-flex items-center justify-center min-h-11 px-4 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200 transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2"
  btn_deposit = "inline-flex items-center justify-center min-h-11 w-full px-4 py-2.5 bg-green-600 text-white text-sm font-medium rounded-md hover:bg-green-700 transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2"
  btn_withdraw = "inline-flex items-center justify-center min-h-11 w-full px-4 py-2.5 bg-red-600 text-white text-sm font-medium rounded-md hover:bg-red-700 transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
  btn_submit_deposit = "inline-flex items-center justify-center min-h-11 px-4 py-2.5 bg-green-600 text-white text-sm font-medium rounded-md hover:bg-green-700 transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-green-600"
  btn_submit_withdraw = "inline-flex items-center justify-center min-h-11 px-4 py-2.5 bg-red-600 text-white text-sm font-medium rounded-md hover:bg-red-700 transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-red-600"
  modal_title_id = "stock-adjustment-modal-title"
%>

<div data-controller="stock-adjustment"
     data-stock-adjustment-deposit-url-value="<%= deposit_stock_path(stock) %>"
     data-stock-adjustment-withdraw-url-value="<%= withdraw_stock_path(stock) %>"
     data-stock-adjustment-deposit-title-value="<%= t("stocks.modal.deposit_title") %>"
     data-stock-adjustment-withdraw-title-value="<%= t("stocks.modal.withdraw_title") %>"
     data-stock-adjustment-confirm-deposit-value="<%= t("stocks.modal.confirm_deposit") %>"
     data-stock-adjustment-confirm-withdraw-value="<%= t("stocks.modal.confirm_withdraw") %>"
     data-stock-adjustment-no-eligible-lots-value="<%= t("stocks.modal.no_eligible_lots") %>"
     data-stock-adjustment-submit-deposit-class-value="<%= btn_submit_deposit %>"
     data-stock-adjustment-submit-withdraw-class-value="<%= btn_submit_withdraw %>"
     data-action="keydown@window->stock-adjustment#closeOnEscape">

  <div class="bg-white border border-gray-200 rounded-lg p-4 mb-6">
    <h2 class="text-sm font-semibold text-gray-700 mb-1"><%= t("stocks.modal.actions_title") %></h2>
    <p class="text-xs text-gray-500 mb-4"><%= t("stocks.modal.actions_hint") %></p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <button type="button"
              class="<%= btn_deposit %>"
              data-action="click->stock-adjustment#openDeposit"
              data-testid="stock-deposit-open">
        <%= t("stocks.modal.deposit_title") %>
      </button>
      <button type="button"
              class="<%= btn_withdraw %>"
              data-action="click->stock-adjustment#openWithdraw"
              data-testid="stock-withdraw-open">
        <%= t("stocks.modal.withdraw_title") %>
      </button>
    </div>
  </div>

  <div class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center p-4 sm:p-6 bg-black/50 backdrop-blur-[1px]"
       data-stock-adjustment-target="modal"
       data-action="click->stock-adjustment#closeOnBackdrop"
       data-testid="stock-adjustment-modal"
       role="presentation">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md max-h-[90dvh] overflow-y-auto"
         role="dialog"
         aria-modal="true"
         aria-labelledby="<%= modal_title_id %>"
         data-action="click->stock-adjustment#stopPropagation">
      <div class="flex items-start justify-between gap-4 border-b border-gray-200 px-6 py-4">
        <div>
          <h2 id="<%= modal_title_id %>"
              class="text-lg font-semibold text-gray-900"
              data-stock-adjustment-target="title"></h2>
          <p class="mt-1 text-xs text-gray-500" data-stock-adjustment-target="subtitle"></p>
        </div>
        <button type="button"
                class="inline-flex items-center justify-center min-h-11 min-w-11 rounded-md text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2"
                data-action="click->stock-adjustment#close"
                aria-label="<%= t("stocks.modal.close") %>"
                data-testid="stock-adjustment-close">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="px-6 py-5">
        <div class="hidden rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800"
             role="alert"
             data-stock-adjustment-target="noLotsMessage"></div>

        <%= form_with url: deposit_stock_path(stock),
                      method: :post,
                      html: {
                        data: { turbo_frame: "_top", stock_adjustment_target: "form" },
                        class: "space-y-4"
                      } do %>
          <div class="space-y-4" data-stock-adjustment-target="fieldsPanel">
            <div>
              <label for="stock_adjustment_lot_id" class="block text-xs font-medium text-gray-600 mb-1">
                <%= t("stocks.modal.lot_label") %>
              </label>
              <select id="stock_adjustment_lot_id"
                      name="product_lot_id"
                      required
                      class="<%= input_class %>"
                      data-stock-adjustment-target="lotSelect"
                      data-testid="stock-adjustment-lot-select">
                <% lots_for_picker.each do |lot| %>
                  <option value="<%= lot.id %>"
                          data-remaining="<%= lot.remaining_quantity %>"
                          data-lot-number="<%= lot.lot_number %>">
                    <%= lot.lot_number %> — <%= lot.received_date.strftime("%d %b %Y") %> — qty: <%= number_with_precision(lot.remaining_quantity, precision: 2) %> — <%= number_to_currency(lot.unit_cost, unit: "\u0e3f", precision: 2) %>
                  </option>
                <% end %>
              </select>
              <p class="mt-1 text-xs text-gray-500"><%= t("stocks.modal.lot_helper") %></p>
            </div>

            <div>
              <label for="stock_adjustment_amount" class="block text-xs font-medium text-gray-600 mb-1">
                <%= t("stocks.modal.amount_label") %>
                <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <%= number_field_tag :amount, nil,
                                   id: "stock_adjustment_amount",
                                   step: "0.01",
                                   min: "0.01",
                                   required: true,
                                   placeholder: "0.00",
                                   class: "#{input_class} font-mono",
                                   data: { stock_adjustment_target: "amountField" } %>
            </div>

            <div>
              <label for="stock_adjustment_reason" class="block text-xs font-medium text-gray-600 mb-1">
                <%= t("stocks.modal.reason_label") %>
              </label>
              <%= text_field_tag :reason, nil,
                                 id: "stock_adjustment_reason",
                                 placeholder: t("stocks.modal.reason_placeholder"),
                                 class: input_class,
                                 data: { stock_adjustment_target: "reasonField" } %>
            </div>
          </div>

          <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2 border-t border-gray-100">
            <button type="button"
                    class="<%= btn_secondary %> sm:min-w-[7rem]"
                    data-action="click->stock-adjustment#close"
                    data-testid="stock-adjustment-cancel">
              <%= t("common.cancel") %>
            </button>
            <button type="submit"
                    formaction="<%= deposit_stock_path(stock) %>"
                    class="<%= btn_submit_deposit %> sm:min-w-[9rem]"
                    data-stock-adjustment-target="submitBtn"
                    data-testid="stock-adjustment-submit">
              <%= t("stocks.modal.confirm_deposit") %>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
