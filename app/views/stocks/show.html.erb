<% content_for :title, "Stock — #{@stock.product.name}" %>

<div class="p-6 max-w-3xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Back to Stock", stocks_path, class: "text-sm text-gray-500 hover:underline" %>
    <h1 class="text-xl font-semibold text-gray-900">
      <%= @stock.product.name %>
      <span class="ml-2 text-sm font-normal text-gray-400 font-mono"><%= @stock.product.sku %></span>
    </h1>
  </div>

  <%# Balance cards %>
  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
      <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Amount</p>
      <p class="text-2xl font-bold text-gray-900 font-mono"><%= number_with_precision(@stock.amount, precision: 2) %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
      <p class="text-xs text-orange-500 uppercase tracking-wider mb-1">Holding</p>
      <p class="text-2xl font-bold text-orange-600 font-mono"><%= number_with_precision(@stock.holding_amount, precision: 2) %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
      <p class="text-xs text-green-600 uppercase tracking-wider mb-1">Available</p>
      <p class="text-2xl font-bold <%= @stock.total_amount < 0 ? "text-red-600" : "text-green-700" %> font-mono">
        <%= number_with_precision(@stock.total_amount, precision: 2) %>
      </p>
    </div>
  </div>

  <%# Deposit / Withdraw forms %>
  <% if policy(@stock).update? %>
    <div class="grid grid-cols-2 gap-4 mb-6">
      <div class="bg-white border border-gray-200 rounded-lg p-4">
        <h2 class="text-sm font-semibold text-gray-700 mb-3">Deposit</h2>
        <%= form_with url: deposit_stock_path(@stock), method: :post, local: true do |f| %>
          <div class="space-y-2">
            <%= number_field_tag :amount, nil, step: "0.01", min: "0.01", placeholder: "Amount",
                                 class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
            <%= text_field_tag :reason, nil, placeholder: "Reason (optional)",
                               class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
            <%= submit_tag "Deposit", class: "w-full inline-flex justify-center px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-md hover:bg-green-700 transition-colors cursor-pointer" %>
          </div>
        <% end %>
      </div>

      <div class="bg-white border border-gray-200 rounded-lg p-4">
        <h2 class="text-sm font-semibold text-gray-700 mb-3">Withdraw</h2>
        <%= form_with url: withdraw_stock_path(@stock), method: :post, local: true do |f| %>
          <div class="space-y-2">
            <%= number_field_tag :amount, nil, step: "0.01", min: "0.01", placeholder: "Amount",
                                 class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
            <%= text_field_tag :reason, nil, placeholder: "Reason (optional)",
                               class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
            <%= submit_tag "Withdraw", class: "w-full inline-flex justify-center px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-md hover:bg-red-700 transition-colors cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="mb-6 flex gap-3">
      <%= link_to "View Transactions", transactions_stock_path(@stock),
                  class: "inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200 transition-colors" %>
      <%= button_to "Recalculate Checkpoint", recalculate_checkpoint_stock_path(@stock), method: :post,
                    class: "inline-flex items-center px-4 py-2 bg-yellow-100 text-yellow-800 text-sm font-medium rounded-md hover:bg-yellow-200 transition-colors",
                    data: { turbo_confirm: "Recalculate checkpoint from transaction history?" } %>
    </div>

    <%# Reset Stock section %>
    <div class="bg-white border border-red-200 rounded-lg p-4 mb-6">
      <h2 class="text-sm font-semibold text-red-700 mb-3">Reset Stock to Zero</h2>
      <%= form_with url: reset_stock_stock_path(@stock), method: :post, local: true do |f| %>
        <div class="space-y-2">
          <%= text_field_tag :reason, nil, placeholder: "Reason (required, max 255 chars)",
                             maxlength: 255, required: true,
                             class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm" %>
          <%= submit_tag "Reset Stock",
                         class: "inline-flex justify-center px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-md hover:bg-red-700 transition-colors cursor-pointer",
                         data: { turbo_confirm: "Reset stock to 0? This cannot be undone." } %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Recent transactions %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-4 py-3 bg-gray-50 border-b border-gray-200">
      <h2 class="text-sm font-semibold text-gray-700">Recent Transactions</h2>
    </div>
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Date</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Type</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">Amount</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Reason</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Adjuster</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @transactions.first(10).each do |txn| %>
          <tr>
            <td class="px-4 py-2 text-gray-500 text-xs"><%= txn.created_at.strftime("%d %b %Y %H:%M") %></td>
            <td class="px-4 py-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                           <%= txn.transaction_type == "IB" ? "bg-green-100 text-green-700" : txn.transaction_type == "RS" ? "bg-yellow-100 text-yellow-700" : "bg-red-100 text-red-700" %>">
                <%= txn.transaction_type %>
              </span>
            </td>
            <td class="px-4 py-2 text-right font-mono text-gray-700"><%= number_with_precision(txn.amount, precision: 2) %></td>
            <td class="px-4 py-2 text-gray-500 text-xs"><%= txn.reason.presence || "—" %></td>
            <td class="px-4 py-2 text-gray-500 text-xs"><%= adjuster_display_name(txn.adjuster) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @transactions.empty? %>
      <p class="px-4 py-6 text-center text-sm text-gray-400">No transactions yet.</p>
    <% end %>
  </div>
</div>
