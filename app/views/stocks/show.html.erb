<% content_for :title, "Stock — #{@stock.product.name}" %>

<div class="p-6 max-w-3xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <h1 class="text-xl font-semibold text-gray-900">
      <%= @stock.product.name %>
      <span class="ml-2 text-sm font-normal text-gray-400 font-mono"><%= @stock.product.sku %></span>
    </h1>
  </div>

  <%# Balance cards %>
  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
      <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Amount</p>
      <p class="text-2xl font-bold text-gray-900 font-mono"><%= number_with_precision(@stock.amount, precision: 2) %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
      <p class="text-xs text-orange-500 uppercase tracking-wider mb-1">Holding</p>
      <p class="text-2xl font-bold text-orange-600 font-mono"><%= number_with_precision(@stock.holding_amount, precision: 2) %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
      <p class="text-xs text-green-600 uppercase tracking-wider mb-1">Available</p>
      <p class="text-2xl font-bold <%= @stock.total_amount < 0 ? "text-red-600" : "text-green-700" %> font-mono">
        <%= number_with_precision(@stock.total_amount, precision: 2) %>
      </p>
    </div>
  </div>

  <%# Deposit / Withdraw forms %>
  <% if policy(@stock).update? %>
    <div class="grid grid-cols-2 gap-4 mb-6">
      <div class="bg-white border border-gray-200 rounded-lg p-4">
        <h2 class="text-sm font-semibold text-gray-700 mb-3">Deposit</h2>
        <%= form_with url: deposit_stock_path(@stock), method: :post, local: true do |f| %>
          <div class="space-y-2">
            <%= number_field_tag :amount, nil, step: "0.01", min: "0.01", placeholder: "Amount",
                                 class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
            <%= text_field_tag :reason, nil, placeholder: "Reason (optional)",
                               class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
            <%= submit_tag "Deposit", class: "w-full inline-flex justify-center px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-md hover:bg-green-700 transition-colors cursor-pointer" %>
          </div>
        <% end %>
      </div>

      <div class="bg-white border border-gray-200 rounded-lg p-4">
        <h2 class="text-sm font-semibold text-gray-700 mb-3">Withdraw</h2>
        <%= form_with url: withdraw_stock_path(@stock), method: :post, local: true do |f| %>
          <div class="space-y-2">
            <%= number_field_tag :amount, nil, step: "0.01", min: "0.01", placeholder: "Amount",
                                 class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
            <%= text_field_tag :reason, nil, placeholder: "Reason (optional)",
                               class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
            <%= submit_tag "Withdraw", class: "w-full inline-flex justify-center px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-md hover:bg-red-700 transition-colors cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="mb-6 flex gap-3">
      <%= link_to "View Transactions", transactions_stock_path(@stock),
                  class: "inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200 transition-colors" %>
      <%= button_to "Recalculate Checkpoint", recalculate_checkpoint_stock_path(@stock), method: :post,
                    class: "inline-flex items-center px-4 py-2 bg-yellow-100 text-yellow-800 text-sm font-medium rounded-md hover:bg-yellow-200 transition-colors",
                    data: { turbo_confirm: "Recalculate checkpoint from transaction history?" } %>
    </div>
  <% end %>

  <%# Stock Person & Locations assignment %>
  <% if policy(@stock).update? %>
    <div class="bg-white border border-gray-200 rounded-lg p-4 mb-6">
      <h2 class="text-sm font-semibold text-gray-700 mb-3">Assignment</h2>
      <%= form_with url: stock_path(@stock), method: :patch, local: true, data: { turbo_frame: "_top" } do |f| %>
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1">Stock Person</label>
            <select name="product_stock[stock_person_id]"
                    class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm"
                    data-controller="tom-select">
              <option value="">— None —</option>
              <% @all_users.each do |u| %>
                <option value="<%= u.id %>" <%= "selected" if @stock.stock_person_id == u.id %>>
                  <%= u.profile&.full_name || u.username %>
                </option>
              <% end %>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1">Stock Locations</label>
            <select name="product_stock[stock_location_ids][]"
                    multiple
                    class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm"
                    data-controller="tom-select"
                    data-tom-select-plugins-value='["remove_button"]'>
              <% @all_stock_locations.each do |loc| %>
                <option value="<%= loc.id %>" <%= "selected" if @stock.stock_location_ids.include?(loc.id) %>>
                  <%= loc.name %>
                </option>
              <% end %>
            </select>
          </div>
          <%= submit_tag "Save Assignment", class: "inline-flex justify-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Recent transactions %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
    <div class="px-4 py-3 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-700">FIFO Lots</h2>
      <%= link_to "View on Product", lots_product_path(@stock.product),
                  class: "text-xs text-blue-600 hover:underline" %>
    </div>
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Lot Number</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Source PO</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Received</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">Original Qty</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">Remaining Qty</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500">Unit Cost</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Status</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @lots.empty? %>
          <tr>
            <td colspan="7" class="px-4 py-6 text-center text-sm text-gray-400">No lots yet — create a Purchase Order to generate FIFO lots.</td>
          </tr>
        <% else %>
          <% @lots.each do |lot| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2 font-mono text-xs text-gray-800"><%= lot.lot_number %></td>
              <td class="px-4 py-2 text-xs">
                <% if lot.purchase_order %>
                  <%= link_to lot.purchase_order.po_number, purchase_order_path(lot.purchase_order),
                               class: "text-blue-600 hover:underline" %>
                <% else %>
                  <span class="text-gray-400">&mdash;</span>
                <% end %>
              </td>
              <td class="px-4 py-2 text-xs text-gray-600"><%= lot.received_date.strftime("%d %b %Y") %></td>
              <td class="px-4 py-2 text-right font-mono text-gray-700"><%= number_with_precision(lot.original_quantity, precision: 2) %></td>
              <td class="px-4 py-2 text-right font-mono text-gray-700"><%= number_with_precision(lot.remaining_quantity, precision: 2) %></td>
              <td class="px-4 py-2 text-right font-mono text-gray-700"><%= number_to_currency(lot.unit_cost, unit: "\u0e3f", precision: 2) %></td>
              <td class="px-4 py-2">
                <% if lot.status == ProductLot::STATUS_ACTIVE %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">Depleted</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

</div>
