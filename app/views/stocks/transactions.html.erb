<% content_for :title, "Transactions — #{@stock.product.name}" %>

<div class="p-6">
  <div class="flex items-center gap-3 mb-6">
    <h1 class="text-xl font-semibold text-gray-900">
      Transactions — <%= @stock.product.name %>
    </h1>
  </div>

  <div class="overflow-hidden border border-gray-200 rounded-lg">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reason</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("stocks.transactions.lot") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Adjuster</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Checkpoint</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @transactions.each do |txn| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 text-gray-500 text-xs"><%= txn.created_at.strftime("%d %b %Y %H:%M") %></td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                           <%= txn.transaction_type == "IB" ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700" %>">
                <%= txn.transaction_type == "IB" ? "↑ In" : "↓ Out" %>
              </span>
            </td>
            <td class="px-4 py-3 text-right font-mono text-gray-700">
              <%= number_with_precision(txn.amount, precision: 2) %>
            </td>
            <td class="px-4 py-3 text-gray-500 text-xs"><%= txn.reason.presence || "—" %></td>
            <td class="px-4 py-3 text-xs"><%= stock_transaction_lot_display(txn) %></td>
            <td class="px-4 py-3 text-gray-500 text-xs"><%= adjuster_display_name(txn.adjuster) %></td>
            <td class="px-4 py-3 text-right font-mono text-gray-400 text-xs">
              <%= txn.recal_checkpoint > 0 ? number_with_precision(txn.recal_checkpoint, precision: 2) : "—" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @transactions.empty? %>
    <div class="mt-8 text-center py-12 text-gray-400">
      <p class="text-sm">No transactions found.</p>
    </div>
  <% end %>

  <div class="mt-4">
    <%== @pagy.series_nav %>
  </div>
</div>
