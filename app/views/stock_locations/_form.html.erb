<% content_for :title, @stock_location.new_record? ? "New Stock Location" : "Edit Stock Location" %>

<div class="p-6 max-w-xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900">
      <%= @stock_location.new_record? ? "New Stock Location" : "Edit — #{@stock_location.name}" %>
    </h1>
  </div>

  <%= form_with model: @stock_location, class: "space-y-5" do |f| %>
    <% if @stock_location.errors.any? %>
      <div class="p-4 bg-red-50 border border-red-200 rounded-md">
        <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
          <% @stock_location.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
      <div>
        <%= f.label :name, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
      <div>
        <%= f.label :description, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_area :description, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="flex gap-3">
      <%= f.submit @stock_location.new_record? ? "Create Stock Location" : "Update Stock Location",
                  class: "px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 cursor-pointer" %>
      <%= link_to "Cancel", stock_locations_path, class: "px-5 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
