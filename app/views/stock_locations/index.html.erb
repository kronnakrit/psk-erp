<% content_for :title, "Stock Locations" %>

<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900">Stock Locations</h1>
    <% if policy(StockLocation).create? %>
      <%= link_to "New Stock Location", new_stock_location_path,
                  class: "px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors" %>
    <% end %>
  </div>

  <%= search_form_for @ransack, url: stock_locations_path do |f| %>
    <div class="flex gap-3 mb-4">
      <%= f.search_field :name_or_description_cont,
                         placeholder: "Search…",
                         class: "flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <%= f.submit "Search", class: "px-4 py-2 bg-gray-100 text-gray-700 text-sm rounded-md hover:bg-gray-200 cursor-pointer" %>
      <%= link_to "Clear", stock_locations_path, class: "px-4 py-2 text-sm text-gray-500 hover:underline" %>
    </div>
  <% end %>

  <div class="overflow-x-auto rounded-lg border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @stock_locations.each do |sl| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-medium text-gray-900"><%= sl.name %></td>
            <td class="px-4 py-3 text-gray-600"><%= sl.description.presence || "—" %></td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-3">
                <% if policy(sl).update? %>
                  <%= link_to "Edit", edit_stock_location_path(sl), class: "text-blue-600 hover:underline text-xs" %>
                <% end %>
                <% if policy(sl).destroy? %>
                  <%= button_to "Delete", stock_location_path(sl), method: :delete,
                                class: "text-red-600 hover:underline text-xs bg-transparent border-none cursor-pointer p-0",
                                data: { turbo_confirm: "Delete #{sl.name}?" } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @stock_locations.empty? %>
          <tr>
            <td colspan="3" class="px-4 py-8 text-center text-gray-400">No stock locations yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
