<tr id="<%= dom_id(unit_definition) %>" class="hover:bg-gray-50 transition-colors">
  <td class="px-6 py-4 font-medium text-gray-900">
    <div class="flex items-center gap-2">
      <%= unit_definition.name %>
      <% if unit_definition.is_main? %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
          Main
        </span>
      <% end %>
      <% if unit_definition.is_migration_placeholder? %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
          Migration placeholder — please review ratio
        </span>
      <% end %>
    </div>
  </td>
  <td class="px-6 py-4 text-center text-gray-600">
    <%= unit_definition.ratio %>
  </td>
  <td class="px-6 py-4 text-right">
    <div class="flex items-center justify-end gap-3">
      <% if policy(unit_definition).set_main? && !unit_definition.is_main? %>
        <%= button_to "Set as Main",
                      set_main_unit_group_unit_definition_path(unit_definition.unit_group, unit_definition),
                      method: :patch,
                      class: "text-blue-600 hover:underline text-sm bg-transparent border-none cursor-pointer p-0",
                      form_class: "inline-block" %>
      <% end %>
      <% if policy(unit_definition).destroy? %>
        <%= button_to "Delete", [unit_definition.unit_group, unit_definition], method: :delete,
                      class: "text-red-600 hover:underline text-sm bg-transparent border-none cursor-pointer p-0",
                      form_class: "inline-block",
                      data: { turbo_confirm: "Delete #{unit_definition.name}?" } %>
      <% end %>
    </div>
  </td>
</tr>
