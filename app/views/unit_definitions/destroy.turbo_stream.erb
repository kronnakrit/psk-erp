<%= turbo_stream.remove dom_id(@unit_definition) %>
<% if @unit_group.unit_definitions.empty? %>
  <%= turbo_stream.append "unit_definitions_list" do %>
    <tr id="empty_unit_definitions">
      <td colspan="3" class="px-6 py-8 text-center text-gray-400">No units defined yet.</td>
    </tr>
  <% end %>
<% end %>
<%= turbo_stream.prepend "flash", partial: "layouts/flash" %>
