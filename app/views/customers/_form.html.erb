<% content_for :title, @customer.new_record? ? "New Customer" : "Edit Customer" %>

<div class="p-6 max-w-2xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900">
      <%= @customer.new_record? ? "New Customer" : "Edit — #{@customer.get_fullname}" %>
    </h1>
    <%= link_to "← Back to Customers", customers_path, class: "text-sm text-blue-600 hover:underline" %>
  </div>

  <%= form_with model: @customer, class: "space-y-6" do |f| %>
    <% if @customer.errors.any? %>
      <div class="p-4 bg-red-50 border border-red-200 rounded-md">
        <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
          <% @customer.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_field :first_name, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>
        <div>
          <%= f.label :last_name, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_field :last_name, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>
      </div>

      <div>
        <%= f.label :telephone, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :telephone, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :country_id, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.select :country_id,
                     options_for_select(@countries.map { |c| [c.printable_name, c.iso_3166_1_a2] }, @customer.country_id),
                     { include_blank: "— Select country —" },
                     class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm",
                     data: { controller: "tom-select" } %>
      </div>

      <div>
        <%= f.label :logistic_company_id, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.select :logistic_company_id,
                     options_for_select(@logistic_companies.map { |lc| [lc.name, lc.id] }, @customer.logistic_company_id),
                     { include_blank: "— Select logistic company —" },
                     class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm",
                     data: { controller: "tom-select" } %>
      </div>

      <div>
        <%= f.label :address, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_area :address, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :remark, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_area :remark, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="flex gap-3">
      <%= f.submit @customer.new_record? ? t("customers.form.submit_create") : t("customers.form.submit_update"),
                  class: "px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 cursor-pointer" %>
      <%= link_to "Cancel", customers_path, class: "px-5 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
