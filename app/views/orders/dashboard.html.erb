<% content_for :title, "Orders Dashboard" %>

<div class="p-6">
  <h1 class="text-xl font-semibold text-gray-900 mb-6">Orders Dashboard</h1>

  <%# KPI cards %>
  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Today's Orders</p>
      <p class="text-3xl font-bold text-gray-900 mt-1"><%= @today_count %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Draft Orders</p>
      <p class="text-3xl font-bold text-yellow-600 mt-1"><%= @draft_count %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Monthly Revenue</p>
      <p class="text-3xl font-bold text-green-700 mt-1"><%= number_to_currency(@monthly_revenue, unit: "฿", precision: 0) %></p>
    </div>
  </div>

  <%# Recent orders %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
      <h2 class="text-sm font-semibold text-gray-700">Recent Orders</h2>
      <%= link_to "View All", orders_path, class: "text-sm text-blue-600 hover:underline" %>
    </div>
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Order #</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @recent_orders.each do |order| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2 font-mono">
              <%= link_to order.order_number, order_path(order), class: "text-blue-600 hover:underline" %>
            </td>
            <td class="px-4 py-2 text-gray-600"><%= order.running_date&.strftime("%d/%m/%Y") %></td>
            <td class="px-4 py-2 text-gray-600"><%= order.customer&.fullname %></td>
            <td class="px-4 py-2"><%= render "orders/status_badge", status: order.status %></td>
            <td class="px-4 py-2 text-right font-medium"><%= number_to_currency(order.grand_total, unit: "฿", precision: 2) %></td>
          </tr>
        <% end %>
        <% if @recent_orders.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-6 text-center text-gray-400 text-xs">No recent orders.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
