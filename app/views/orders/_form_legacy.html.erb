<%# Order form — used by new.html.erb and edit.html.erb %>
<%= form_with model: order, class: "space-y-6" do |f| %>

  <%# Validation errors %>
  <% if order.errors.any? %>
    <div class="p-4 bg-red-50 border border-red-200 rounded-md">
      <p class="text-sm font-medium text-red-800 mb-1">Please fix the following errors:</p>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
        <% order.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-3 gap-6">
    <div class="col-span-2 space-y-6">

      <%# Basic info %>
      <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
        <h2 class="text-sm font-semibold text-gray-700">Order Information</h2>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :customer_id, "Customer", class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= f.collection_select :customer_id, @customers, :id, :fullname,
                                    { include_blank: "— Select Customer —" },
                                    class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm",
                                    data: { controller: "tom-select" } %>
          </div>
          <div>
            <%= f.label :running_date, "Order Date", class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= f.date_field :running_date, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :telephone, class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= f.telephone_field :telephone, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
          <div>
            <%= f.label :status, class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= f.select :status,
                         Order::STATUSES.map { |s| [s == "Dr" ? "Draft" : s == "Pd" ? "Paid" : s == "Cp" ? "Completed" : "Cancelled", s] },
                         {},
                         class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm",
                         data: { controller: "tom-select" } %>
          </div>
        </div>

        <div>
          <%= f.label :address, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_area :address, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :logistic_company_id, "Logistic Company", class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= f.collection_select :logistic_company_id, @logistic_companies, :id, :name,
                                    { include_blank: "— None —" },
                                    class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm",
                                    data: { controller: "tom-select" } %>
          </div>
          <div>
            <%= f.label :logistic_status, class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= f.select :logistic_status, Order::LOGISTIC_STATUSES,
                         {},
                         class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm",
                         data: { controller: "tom-select" } %>
          </div>
        </div>

        <div>
          <%= f.label :remark, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_area :remark, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :internal_note, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_area :internal_note, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>
      </div>

      <%# Pricing options %>
      <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
        <h2 class="text-sm font-semibold text-gray-700">Pricing Options</h2>

        <div class="grid grid-cols-3 gap-4">
          <div class="flex items-center gap-2">
            <%= f.check_box :has_vat, class: "h-4 w-4 text-blue-600 border-gray-300 rounded" %>
            <%= f.label :has_vat, "Apply VAT (7%)", class: "text-sm text-gray-700" %>
          </div>
          <div class="flex items-center gap-2">
            <%= f.check_box :is_included_vat, class: "h-4 w-4 text-blue-600 border-gray-300 rounded" %>
            <%= f.label :is_included_vat, "VAT Included", class: "text-sm text-gray-700" %>
          </div>
          <div class="flex items-center gap-2">
            <%= f.check_box :is_withholding_tax, class: "h-4 w-4 text-blue-600 border-gray-300 rounded" %>
            <%= f.label :is_withholding_tax, "Withholding Tax", class: "text-sm text-gray-700" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :withholding_tax, "WHT (%)", class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= f.number_field :withholding_tax, step: 0.01, min: 0, max: 100,
                               class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-4">
          <div class="col-span-1 flex items-center gap-2">
            <%= f.check_box :is_discount_percentage, class: "h-4 w-4 text-blue-600 border-gray-300 rounded" %>
            <%= f.label :is_discount_percentage, "Discount %", class: "text-sm text-gray-700" %>
          </div>
          <div>
            <%= f.label :discount_percentage, "Discount %", class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= f.number_field :discount_percentage, step: 0.01, min: 0, max: 100,
                               class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
          <div>
            <%= f.label :discount_price, "Discount Amount (฿)", class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= f.number_field :discount_price, step: 0.01, min: 0,
                               class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
        </div>
      </div>

      <%# Order lines (nested) %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden"
           data-controller="order-line">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
          <h2 class="text-sm font-semibold text-gray-700">Order Lines</h2>
          <button type="button"
                  data-action="click->order-line#addLine"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 text-blue-700 text-xs font-medium rounded-md hover:bg-blue-100 transition-colors">
            + Add Line
          </button>
        </div>

        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
              <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase w-24">Unit</th>
              <th class="px-3 py-2 text-right text-xs font-medium text-gray-500 uppercase w-20">Qty</th>
              <th class="px-3 py-2 text-right text-xs font-medium text-gray-500 uppercase w-28">Unit Price</th>
              <th class="px-3 py-2 text-right text-xs font-medium text-gray-500 uppercase w-28">Discount</th>
              <th class="px-3 py-2 text-right text-xs font-medium text-gray-500 uppercase w-28">Total</th>
              <th class="w-8"></th>
            </tr>
          </thead>
          <tbody id="order_lines_fields" data-order-line-target="container">
            <%= f.fields_for :order_lines do |lf| %>
              <%= render "orders/order_line_fields", f: lf %>
            <% end %>
          </tbody>
        </table>

        <%# Hidden template for JS new-line insertion %>
        <template data-order-line-target="template">
          <%= f.fields_for :order_lines, OrderLine.new, child_index: "NEW_LINE_RECORD" do |lf| %>
            <%= render "orders/order_line_fields", f: lf %>
          <% end %>
        </template>
      </div>

    </div>

    <%# Right column: Preview grand total (read-only, static on form page) %>
    <div class="col-span-1">
      <% unless order.new_record? %>
        <%= turbo_frame_tag "grand_total_panel" do %>
          <%= render "orders/grand_total", order: order %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Form actions %>
  <div class="flex items-center gap-3 pt-2">
    <%= f.submit order.new_record? ? "Create Order" : "Update Order",
                 class: "px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors cursor-pointer" %>
    <%= link_to "Cancel", order.new_record? ? orders_path : order_path(order),
                class: "px-5 py-2 border border-gray-300 text-gray-700 text-sm rounded-md hover:bg-gray-50 transition-colors" %>
  </div>

<% end %>
