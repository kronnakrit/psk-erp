<% content_for :title, "บิลขนส่ง – #{@order.order_number}" %>

<%# ===== Print & Screen CSS ===== %>
<style>
  /* ---- Screen styles ---- */
  #print-container {
    max-width: 210mm;
    margin: 0 auto;
    padding: 6mm 8mm 4mm;
    font-family: 'Sarabun', 'Noto Sans Thai', sans-serif;
    font-size: 13pt;
  }

  .doc-heading {
    font-size: 18pt;
    font-weight: 700;
    text-align: center;
    margin-bottom: 0;
    letter-spacing: 0.04em;
  }

  .meta-label {
    font-weight: 600;
    width: 90px;
    flex-shrink: 0;
  }

  .doc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13pt;
  }

  .doc-table th,
  .doc-table td {
    border: 1px solid #444;
    padding: 3px 6px;
    vertical-align: middle;
    line-height: 1.4;
  }

  .doc-table th {
    background-color: #e5e7eb;
    font-weight: 700;
    text-align: center;
    font-size: 12pt;
  }

  .doc-table td.num {
    text-align: right;
    white-space: nowrap;
  }

  .doc-table td.center {
    text-align: center;
  }

  /* Bottom section: signature (left) + totals (right) side-by-side */
  .bottom-section {
    display: flex;
    gap: 16px;
    align-items: flex-end;
    margin-top: 8px;
  }

  .sig-block {
    flex: 1 1 120px;
    min-width: 120px;
  }

  .sig-line {
    font-size: 13pt;
    padding-top: 28px;
    width: 100%;
    display: flex;
    align-items: flex-end;
    gap: 4px;
  }

  .sig-underline {
    flex: 1;
    border-bottom: 1px solid #444;
    margin-bottom: 3px;
    min-width: 20px;
  }

  .totals-block {
    flex: 0 0 auto;
    min-width: 280px;
  }

  /* Detail rows (subtotal, discount, VAT, WHT) — compact */
  .totals-detail-row {
    display: flex;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 0;
    font-size: 10pt;
    color: #4b5563;
  }

  .totals-detail-label { width: 160px; text-align: right; }
  .totals-detail-value { min-width: 100px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }

  /* Grand total row — prominent */
  .totals-grand-row {
    display: flex;
    justify-content: flex-end;
    gap: 0.4rem;
    padding-top: 3px;
    margin-top: 3px;
    border-top: 2px solid #333;
  }

  .totals-grand-label { width: 160px; text-align: right; font-weight: 700; font-size: 12pt; white-space: nowrap; }
  .totals-grand-value { min-width: 110px; text-align: right; font-weight: 700; font-size: 15pt; white-space: nowrap; font-variant-numeric: tabular-nums; }

  /* ---- Print-only styles ---- */
  @media print {
    .no-print { display: none !important; }

    body {
      font-size: 13pt;
      background: white;
    }

    #print-container {
      max-width: 100%;
      margin: 0;
      padding: 4mm 6mm 2mm;
    }

    .doc-table th,
    .doc-table td {
      padding: 2px 5px;
      line-height: 1.35;
    }
  }

  @page {
    @bottom-right {
      content: counter(page) "/" counter(pages);
      font-family: 'Sarabun', 'Noto Sans Thai', sans-serif;
      font-size: 9pt;
      color: #6b7280;
    }
  }
</style>

<%# ===== Outer wrapper — controller must enclose BOTH controls and content ===== %>
<div data-controller="delivery-order">

  <%# ===== Print controls (hidden on print) ===== %>
  <div class="no-print bg-gray-100 border-b border-gray-300 px-6 py-3 flex items-center gap-6 sticky top-0 z-10">
    <span class="text-sm font-medium text-gray-700">Paper size:</span>
    <label class="flex items-center gap-1 text-sm cursor-pointer">
      <input type="radio" name="paper_size" value="A4" checked
             data-action="change->delivery-order#selectSize"
             class="accent-blue-600">
      A4
    </label>
    <label class="flex items-center gap-1 text-sm cursor-pointer">
      <input type="radio" name="paper_size" value="A5"
             data-action="change->delivery-order#selectSize"
             class="accent-blue-600">
      A5
    </label>
    <button data-action="click->delivery-order#printPage"
            class="px-4 py-1.5 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors">
      พิมพ์
    </button>
    <%= link_to "← กลับ", order_path(@order),
                class: "text-sm text-gray-500 hover:underline ml-auto" %>
  </div>

  <%# ===== Document ===== %>
  <div id="print-container">

    <%# ---- Header row 1: barcode (left) | title (center) | date (right) ---- %>
    <div class="flex items-center mb-1">
      <%# Left: barcode %>
      <div class="flex flex-col items-center" style="min-width:120px">
        <svg data-delivery-order-target="barcode"
             data-order-number="<%= @order.order_number %>">
        </svg>
        <p class="text-xs font-mono mt-0.5"><%= @order.order_number %></p>
      </div>

      <%# Center: document title %>
      <div class="flex-1 text-center">
        <div class="doc-heading">บิลขนส่ง</div>
      </div>

      <%# Right: date + order number %>
      <div class="flex flex-col items-end" style="min-width:120px">
        <div class="flex gap-1 text-sm">
          <span class="meta-label">เลขที่</span>
          <span><%= @order.order_number %></span>
        </div>
        <div class="flex gap-1 text-sm">
          <span class="meta-label">วันที่</span>
          <span><%= @order.running_date&.strftime("%d/%m/%Y") %></span>
        </div>
      </div>
    </div>

    <%# ---- Header row 2: name | telephone in one line ---- %>
    <dl class="mb-0.5">
      <div class="flex gap-4">
        <div class="flex gap-1 flex-1 min-w-0">
          <dt class="meta-label flex-shrink-0">ลูกค้า</dt>
          <dd class="truncate"><%= @order.customer&.fullname %></dd>
        </div>
        <div class="flex gap-1 flex-shrink-0">
          <dt class="meta-label">โทรศัพท์</dt>
          <dd><%= @order.telephone.presence || "—" %></dd>
        </div>
      </div>
    </dl>

    <%# ---- Header row 3: address (full width) ---- %>
    <dl class="mb-2">
      <div class="flex gap-1">
        <dt class="meta-label flex-shrink-0">ที่อยู่</dt>
        <dd class="break-words flex-1"><%= @order.address.presence || "—" %></dd>
      </div>
      <div class="flex gap-1 mt-0.5">
        <dt class="meta-label flex-shrink-0">บริษัทขนส่ง</dt>
        <dd><%= @order.logistic_company&.name || "—" %></dd>
      </div>
      <% if @order.remark.present? %>
        <div class="flex gap-1 mt-0.5">
          <dt class="meta-label flex-shrink-0">หมายเหตุ</dt>
          <dd class="break-words flex-1"><%= @order.remark %></dd>
        </div>
      <% end %>
    </dl>

    <%# ---- Order lines table ---- %>
    <table class="doc-table mb-2">
      <thead>
        <tr>
          <th class="w-8">NO.</th>
          <th class="w-14">จำนวน</th>
          <th class="w-14">หน่วย</th>
          <th>รายละเอียด</th>
          <th class="w-24">ราคาต่อหน่วย</th>
          <th class="w-24">รวม</th>
          <th class="w-14"></th>
        </tr>
      </thead>
      <tbody>
        <% @order_lines.each.with_index(1) do |line, idx| %>
          <tr>
            <td class="center"><%= idx %></td>
            <td class="num"><%= number_with_precision(line.quantity, precision: 0, delimiter: ",") %></td>
            <td class="center"><%= line.unit_definition&.name || "—" %></td>
            <td><%= line.product&.name %></td>
            <td class="num"><%= number_with_precision(line.unit_price.to_f, precision: 2, delimiter: ",") %></td>
            <td class="num"><%= number_with_precision(line.total_price.to_f, precision: 2, delimiter: ",") %></td>
            <td></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%# ---- Bottom: Signature (left) + Totals (right) ---- %>
    <% gt = ::GrandTotalCalculator.new(@order).call %>
    <div class="bottom-section">

      <%# Left: Signature %>
      <div class="sig-block">
        <div class="sig-line">
          <span>ลงชื่อ</span>
          <span class="sig-underline"></span>
          <span>ผู้รับของ</span>
        </div>
      </div>

      <%# Right: Totals %>
      <div class="totals-block">
        <div class="totals-detail-row">
          <span class="totals-detail-label">ยอดรวม (Subtotal)</span>
          <span class="totals-detail-value">฿<%= number_with_precision(gt[:total_price].to_f, precision: 2, delimiter: ",") %></span>
        </div>

        <% if gt[:discount_amount].nonzero? %>
          <div class="totals-detail-row">
            <span class="totals-detail-label">ส่วนลด (Discount)</span>
            <span class="totals-detail-value" style="color:#dc2626;">− ฿<%= number_with_precision(gt[:discount_amount].to_f, precision: 2, delimiter: ",") %></span>
          </div>
        <% end %>

        <% if @order.has_vat? %>
          <div class="totals-detail-row">
            <span class="totals-detail-label">ราคาก่อน VAT</span>
            <span class="totals-detail-value">฿<%= number_with_precision(gt[:price_excl_vat].to_f, precision: 2, delimiter: ",") %></span>
          </div>
          <div class="totals-detail-row">
            <span class="totals-detail-label">VAT 7%</span>
            <span class="totals-detail-value">฿<%= number_with_precision(gt[:vat_price].to_f, precision: 2, delimiter: ",") %></span>
          </div>
        <% end %>

        <% if @order.is_withholding_tax? && gt[:withholding_tax_amount].nonzero? %>
          <div class="totals-detail-row">
            <span class="totals-detail-label">หักภาษี ณ ที่จ่าย (<%= @order.withholding_tax %>%)</span>
            <span class="totals-detail-value" style="color:#dc2626;">− ฿<%= number_with_precision(gt[:withholding_tax_amount].to_f, precision: 2, delimiter: ",") %></span>
          </div>
        <% end %>

        <div class="totals-grand-row">
          <span class="totals-grand-label">รวมทั้งสิ้น</span>
          <span class="totals-grand-value">฿<%= number_with_precision(gt[:grand_total].to_f, precision: 2, delimiter: ",") %></span>
        </div>
      </div>

    </div>

  </div><%# /#print-container %>

</div><%# /data-controller %>

