<% content_for :title, "Order #{@order.order_number}" %>

<div class="p-4 md:p-6">
  <%# Header %>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-semibold text-gray-900">Order <%= @order.order_number %></h1>
      <p class="text-sm text-gray-500 mt-0.5"><%= @order.running_date&.strftime("%d %B %Y") %></p>
    </div>
    <div class="flex items-center gap-2">
      <% if policy(@order).export? %>
        <%= link_to "Export Invoice", export_order_path(@order),
                    class: "px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-md hover:bg-green-700 transition-colors" %>
      <% end %>
      <% if policy(@order).edit? && @order.status != "Cc" %>
        <%= link_to "Edit Order", edit_order_path(@order),
                    class: "px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors" %>
      <% end %>
      <% if policy(@order).duplicate? %>
        <%= button_to "Duplicate", duplicate_order_path(@order), method: :post,
                      class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 transition-colors cursor-pointer",
                      form: { class: "inline-flex", data: { turbo_confirm: "Duplicate this order? A new Draft order will be created with today's date." } } %>
      <% end %>
      <%= link_to "← Back", orders_path, class: "text-sm text-blue-600 hover:underline" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Left column — order details %>
    <div class="lg:col-span-2 space-y-6">

      <%# Order info card %>
      <div class="bg-white border border-gray-200 rounded-lg p-5">
        <h2 class="text-sm font-semibold text-gray-700 mb-4">Order Details</h2>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
          <div>
            <dt class="text-xs text-gray-500 font-medium">Status</dt>
            <dd class="mt-0.5"><%= render "orders/status_badge", status: @order.status %></dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500 font-medium">Logistic Status</dt>
            <dd class="mt-0.5 text-gray-800"><%= logistic_status_label(@order.logistic_status) %></dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500 font-medium">Customer</dt>
            <dd class="mt-0.5 text-gray-800"><%= @order.customer&.fullname %></dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500 font-medium">Logistic Company</dt>
            <dd class="mt-0.5 text-gray-800"><%= @order.logistic_company&.name || "—" %></dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500 font-medium">Telephone</dt>
            <dd class="mt-0.5 text-gray-800"><%= @order.telephone.presence || "—" %></dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500 font-medium">Address</dt>
            <dd class="mt-0.5 text-gray-800"><%= @order.address.presence || "—" %></dd>
          </div>
          <% if @order.remark.present? %>
            <div class="col-span-2">
              <dt class="text-xs text-gray-500 font-medium">Remark</dt>
              <dd class="mt-0.5 text-gray-800"><%= @order.remark %></dd>
            </div>
          <% end %>
          <% if policy(@order).update? && @order.internal_note.present? %>
            <div class="col-span-2">
              <dt class="text-xs text-gray-500 font-medium">Internal Note</dt>
              <dd class="mt-0.5 text-gray-800 italic"><%= @order.internal_note %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <%# Order lines %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
          <h2 class="text-sm font-semibold text-gray-700">Order Lines</h2>
        </div>
        <div id="order_lines" class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Unit</th>
                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Qty</th>
                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Unit Price</th>
                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Discount</th>
                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Line Total</th>
                <% if policy(@order).update? %>
                  <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
                <% end %>
              </tr>
            </thead>
            <tbody id="order_lines_body" class="bg-white divide-y divide-gray-200">
              <% @order_lines.each do |line| %>
                <%= render "order_lines/order_line", order_line: line, order: @order %>
              <% end %>
              <% if @order_lines.empty? %>
                <tr>
                  <td colspan="<%= policy(@order).update? ? 8 : 7 %>"
                      class="px-4 py-6 text-center text-gray-400 text-xs">
                    No lines yet.
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <%# Right column — grand total %>
    <div class="lg:col-span-1">
      <%= turbo_frame_tag "grand_total_panel" do %>
        <%= render "orders/grand_total", order: @order %>
      <% end %>
    </div>
  </div>

  <%# Order images %>
  <div class="mt-6 bg-white border border-gray-200 rounded-lg p-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-semibold text-gray-700">Images</h2>
    </div>
    <div id="order_images" class="flex flex-wrap gap-3">
      <% @order.order_images.order(:position).each do |oi| %>
        <%= render "order_images/order_image", order_image: oi %>
      <% end %>
    </div>
    <% if policy(@order).update? %>
      <div class="mt-4 pt-4 border-t border-gray-100">
        <%= form_with url: order_order_images_path(@order), scope: :order_image, multipart: true, data: { controller: "order-image-upload", "order-image-upload-target": "form" } do |f| %>
          <div class="flex items-center gap-3">
            <%= f.file_field :image, accept: "image/*",
                             data: { action: "change->order-image-upload#toggle", "order-image-upload-target": "fileInput" },
                             class: "text-sm text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
            <%= f.submit "Upload", disabled: true,
                         data: { "order-image-upload-target": "submitBtn" },
                         class: "px-3 py-1.5 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Change History — lazy-loaded via Turbo Frame, visible only with view_order_audit permission %>
  <% if policy(@order).audit? %>
    <div class="mt-6 bg-white border border-gray-200 rounded-lg p-5">
      <h2 class="text-sm font-semibold text-gray-700 mb-4">Change History</h2>
      <%= turbo_frame_tag "order_audit_trail",
                          src: audit_trail_order_path(@order),
                          loading: "lazy" do %>
        <div class="space-y-3 animate-pulse">
          <div class="h-4 bg-gray-200 rounded w-3/4"></div>
          <div class="h-4 bg-gray-200 rounded w-1/2"></div>
          <div class="h-4 bg-gray-200 rounded w-2/3"></div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
