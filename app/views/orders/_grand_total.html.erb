<%# Grand total panel — used in show.html.erb and via Turbo Stream %>
<% gt = ::GrandTotalCalculator.new(order).call %>

<div class="bg-white border border-gray-200 rounded-lg p-5 space-y-2 text-sm sticky top-6">
  <h2 class="text-sm font-semibold text-gray-700 mb-3">Summary</h2>

  <div class="flex justify-between text-gray-600">
    <span>Subtotal</span>
    <span><%= number_to_currency(gt[:total_price], unit: "฿", precision: 2) %></span>
  </div>

  <% if gt[:discount_amount].nonzero? %>
    <div class="flex justify-between text-gray-600">
      <span>Discount</span>
      <span class="text-red-600">− <%= number_to_currency(gt[:discount_amount], unit: "฿", precision: 2) %></span>
    </div>
    <div class="flex justify-between text-gray-600">
      <span>After Discount</span>
      <span><%= number_to_currency(gt[:price_with_discount], unit: "฿", precision: 2) %></span>
    </div>
  <% end %>

  <% if order.has_vat? %>
    <div class="flex justify-between text-gray-600">
      <span>Excl. VAT</span>
      <span><%= number_to_currency(gt[:price_excl_vat], unit: "฿", precision: 2) %></span>
    </div>
    <div class="flex justify-between text-gray-600">
      <span>VAT (7%)</span>
      <span><%= number_to_currency(gt[:vat_price], unit: "฿", precision: 2) %></span>
    </div>
  <% end %>

  <% if order.is_withholding_tax? && gt[:withholding_tax_amount].nonzero? %>
    <div class="flex justify-between text-gray-600">
      <span>Withholding Tax (<%= order.withholding_tax %>%)</span>
      <span class="text-red-600">− <%= number_to_currency(gt[:withholding_tax_amount], unit: "฿", precision: 2) %></span>
    </div>
  <% end %>

  <div class="flex justify-between font-semibold text-gray-900 pt-2 border-t border-gray-200 mt-2">
    <span>Grand Total</span>
    <span class="text-lg"><%= number_to_currency(gt[:grand_total], unit: "฿", precision: 2) %></span>
  </div>
</div>
