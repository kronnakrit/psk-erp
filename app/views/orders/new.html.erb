<% content_for :title, @order.new_record? ? "New Order" : "Edit Order — #{@order.order_number}" %>

<div class="p-4 md:p-6">
  <%# Header %>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900">
      <%= @order.new_record? ? "New Order" : "Edit Order — #{@order.order_number}" %>
    </h1>
    <%= link_to "← Back to Orders", orders_path, class: "text-sm text-blue-600 hover:underline" %>
  </div>

  <%= render "orders/form", order: @order %>
</div>
