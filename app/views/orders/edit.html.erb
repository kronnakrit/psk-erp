<% content_for :title, "Edit Order — #{@order.order_number}" %>

<div class="p-4 md:p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900">Edit Order — <%= @order.order_number %></h1>
    <div class="flex items-center gap-2">
      <%= link_to "View Order", order_path(@order), class: "text-sm text-blue-600 hover:underline" %>
    </div>
  </div>

  <%= render "orders/form", order: @order %>
</div>
