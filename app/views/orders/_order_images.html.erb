<%# Order images panel — used inside _form.html.erb footer %>
<%= turbo_frame_tag "order_images_panel" do %>
  <div class="bg-white border border-gray-200 rounded-lg p-5">
    <h2 class="text-sm font-semibold text-gray-700 mb-3">Images</h2>

    <% if order.new_record? %>
      <p class="text-sm text-gray-400">Images can be attached after saving the order.</p>
    <% else %>
      <div id="order_images" class="flex flex-wrap gap-3">
        <% order.order_images.order(:position).each do |oi| %>
          <%= render "order_images/order_image", order_image: oi %>
        <% end %>
        <% if order.order_images.empty? %>
          <p class="text-sm text-gray-400">No images yet.</p>
        <% end %>
      </div>

      <% if policy(order).update? %>
        <div class="mt-4 pt-4 border-t border-gray-100">
          <%= form_with url: order_order_images_path(order), multipart: true do |f| %>
            <div class="flex items-center gap-3">
              <%= f.file_field :order_image_image, accept: "image/*",
                               class: "text-sm text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
              <%= f.submit "Upload",
                           class: "px-3 py-1.5 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 transition-colors" %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
