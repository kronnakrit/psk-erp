<% content_for :title, "Company Settings" %>

<div class="p-4 md:p-6 max-w-2xl" data-testid="company-settings-page">
  <h1 class="text-xl font-semibold text-gray-900 mb-6">Company Settings</h1>

  <%= form_with model: @company_setting, url: company_setting_path, method: :patch, multipart: true do |f| %>
    <% if @company_setting.errors.any? %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-md text-sm text-red-700">
        <ul class="list-disc list-inside">
          <% @company_setting.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Company Name <span class="text-red-500">*</span></label>
        <%= f.text_field :company_name,
                         class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
                         data: { testid: "company-name-input" }, required: true %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
        <%= f.text_area :company_address, rows: 3,
                        class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
                        data: { testid: "company-address-input" } %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Telephone</label>
          <%= f.text_field :company_telephone,
                           class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm",
                           data: { testid: "company-telephone-input" } %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Tax ID</label>
          <%= f.text_field :company_tax_id,
                           class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm",
                           data: { testid: "company-tax-id-input" } %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <%= f.email_field :company_email,
                            class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm",
                            data: { testid: "company-email-input" } %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Website</label>
          <%= f.url_field :company_website,
                          class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm",
                          data: { testid: "company-website-input" } %>
        </div>
      </div>

      <%# Logo %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Logo</label>
        <% if @company_setting.logo.attached? %>
          <div class="mb-3 flex items-center gap-4">
            <%= image_tag @company_setting.logo, class: "h-16 object-contain border border-gray-200 rounded-md p-1" %>
            <label class="flex items-center gap-2 text-sm text-red-600 cursor-pointer">
              <%= check_box_tag "company_setting[remove_logo]", "1", false,
                                data: { testid: "remove-logo-checkbox" } %>
              Remove Logo
            </label>
          </div>
        <% end %>
        <%= f.file_field :logo, accept: "image/*",
                         class: "text-sm text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100",
                         data: { testid: "logo-input" } %>
      </div>

      <div class="flex justify-end pt-2">
        <%= f.submit "Save",
                     class: "px-6 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700",
                     data: { testid: "save-settings-btn" } %>
      </div>
    </div>
  <% end %>
</div>
