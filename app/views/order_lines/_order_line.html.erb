<%# Single order line row — used in show.html.erb and Turbo Stream responses %>
<tr id="order_line_<%= order_line.id %>" class="hover:bg-gray-50">
  <td class="px-4 py-3 text-gray-800">
    <%= order_line.product&.name || "—" %>
  </td>
  <td class="px-4 py-3 text-gray-600 text-xs"><%= order_line.description.presence || "—" %></td>
  <td class="px-4 py-3 text-gray-600"><%= order_line.unit_definition&.name || "—" %></td>
  <td class="px-4 py-3 text-right text-gray-700"><%= number_with_precision(order_line.quantity, precision: 2) %></td>
  <td class="px-4 py-3 text-right text-gray-700"><%= number_to_currency(order_line.unit_price, unit: "฿", precision: 2) %></td>
  <td class="px-4 py-3 text-right text-gray-700"><%= number_to_currency(order_line.discount_price, unit: "฿", precision: 2) %></td>
  <td class="px-4 py-3 text-right font-medium text-gray-900"><%= number_to_currency(order_line.total_price, unit: "฿", precision: 2) %></td>
  <% if policy(order_line).destroy? %>
    <td class="px-4 py-3 text-right">
      <%= button_to "Remove", order_order_line_path(order, order_line), method: :delete,
                    class: "text-red-600 hover:underline text-xs bg-transparent border-none cursor-pointer p-0",
                    data: { turbo_confirm: "Remove this line?" } %>
    </td>
  <% end %>
</tr>
