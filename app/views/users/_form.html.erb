<% content_for :title, @user.new_record? ? "New User" : "Edit User" %>

<div class="p-6 max-w-2xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900">
      <%= @user.new_record? ? "New User" : "Edit User — #{@user.username}" %>
    </h1>
    <%= link_to "← Back to Users", users_path, class: "text-sm text-blue-600 hover:underline" %>
  </div>

  <%= form_with model: @user, class: "space-y-6" do |f| %>
    <%# Validation errors %>
    <% if @user.errors.any? %>
      <div class="p-4 bg-red-50 border border-red-200 rounded-md">
        <p class="text-sm font-medium text-red-800 mb-1"><%= t("users.form.errors") %></p>
        <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
      <h2 class="text-sm font-semibold text-gray-700"><%= t("users.form.account_details") %></h2>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :username, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_field :username, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>
        <div>
          <%= f.label :email, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>
      </div>

      <% if @user.new_record? %>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :password, class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= f.password_field :password, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
          <div>
            <%= f.label :password_confirmation, class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= f.password_field :password_confirmation, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
        </div>
      <% end %>

      <div class="flex items-center gap-2">
        <%= f.check_box :is_active, class: "h-4 w-4 text-blue-600 border-gray-300 rounded" %>
        <%= f.label :is_active, class: "text-sm text-gray-700" %>
      </div>
    </div>

    <%# Profile details %>
    <%= f.fields_for :profile do |pf| %>
      <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
        <h2 class="text-sm font-semibold text-gray-700"><%= t("users.form.profile") %></h2>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= pf.label :first_name, class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= pf.text_field :first_name, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
          <div>
            <%= pf.label :last_name, class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= pf.text_field :last_name, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
        </div>

        <div>
          <%= pf.label :role_id, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= pf.collection_select :role_id, Role.order(:name), :id, :name,
                                   { include_blank: "— No Role —" },
                                   class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= pf.label :telephone, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= pf.text_field :telephone, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= pf.label :address, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= pf.text_area :address, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= pf.label :remark, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= pf.text_area :remark, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>
      </div>
    <% end %>

    <%# Force password reset (edit only) %>
    <% unless @user.new_record? %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-5">
        <h2 class="text-sm font-semibold text-gray-700 mb-3"><%= t("users.form.force_password_reset") %></h2>
        <%= form_with url: user_force_password_path(@user), method: :patch, class: "grid grid-cols-2 gap-4" do |fp| %>
          <div>
            <%= label_tag :password1, "New Password", class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= password_field_tag :password1, nil, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
          <div>
            <%= label_tag :password2, "Confirm Password", class: "block text-xs font-medium text-gray-700 mb-1" %>
            <%= password_field_tag :password2, nil, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
          <div class="col-span-2">
            <%= submit_tag "Set Password", class: "px-4 py-2 bg-yellow-600 text-white text-sm font-medium rounded-md hover:bg-yellow-700 cursor-pointer" %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="flex gap-3">
      <%= f.submit @user.new_record? ? t("users.form.submit_create") : t("users.form.submit_update"),
                  class: "px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 cursor-pointer" %>
      <%= link_to "Cancel", users_path, class: "px-5 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
