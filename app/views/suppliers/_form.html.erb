<% content_for :title, @supplier.new_record? ? "New Supplier" : "Edit Supplier" %>

<div class="p-6 max-w-2xl">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to suppliers_path, class: "text-gray-400 hover:text-gray-600" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
    <h1 class="text-xl font-semibold text-gray-900">
      <%= @supplier.new_record? ? "New Supplier" : "Edit — #{@supplier.name}" %>
    </h1>
  </div>

  <%= form_with model: @supplier, class: "space-y-6" do |f| %>
    <% if @supplier.errors.any? %>
      <div class="p-4 bg-red-50 border border-red-200 rounded-md">
        <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
          <% @supplier.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
      <div>
        <%= f.label :name, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :telephone, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :telephone, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :address, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_area :address, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :remark, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_area :remark, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="flex items-center gap-2">
        <%= f.check_box :is_active, class: "h-4 w-4 text-blue-600 border-gray-300 rounded" %>
        <%= f.label :is_active, "Active", class: "text-sm text-gray-700" %>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3 mt-6">
      <%= link_to "Cancel", suppliers_path, class: "px-5 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50" %>
      <%= f.submit @supplier.new_record? ? "Create Supplier" : "Update Supplier",
                  class: "px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 cursor-pointer" %>
    </div>
  <% end %>
</div>
