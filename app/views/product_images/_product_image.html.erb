<div class="relative group">
  <%= image_tag product_image.image, class: "w-full h-24 object-cover rounded-md border border-gray-100" %>
  <% if policy(product_image).destroy? %>
    <%= button_to product_product_image_path(product, product_image), method: :delete,
                  class: "absolute top-1 right-1 hidden group-hover:flex items-center justify-center w-5 h-5 bg-red-500 text-white rounded-full text-xs leading-none",
                  data: { turbo_confirm: "Remove this image?" } do %>
      &times;
    <% end %>
  <% end %>
</div>
