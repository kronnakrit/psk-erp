<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "PSK ERP" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="PSK ERP">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.default.min.css">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <%= render "layouts/header" %>

    <div class="flex h-[calc(100vh-4rem)] overflow-hidden">
      <%# Sidebar — hidden on mobile, toggled via stimulus %>
      <aside id="sidebar"
             class="hidden lg:flex lg:flex-shrink-0"
             data-controller="sidebar">
        <%= render "layouts/sidebar" %>
      </aside>

      <%# Mobile overlay backdrop %>
      <div id="sidebar-overlay"
           class="fixed inset-0 z-20 bg-black/40 lg:hidden hidden"
           data-action="click->sidebar#close"></div>

      <%# Main content %>
      <main class="flex-1 overflow-y-auto p-6">
        <%= render "layouts/flash" %>
        <%= turbo_frame_tag "main_content" do %>
          <%= yield %>
        <% end %>
      </main>
    </div>
  </body>
</html>
</html>
