<% content_for :title, t("purchase_orders.title") %>

<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900"><%= t("purchase_orders.title") %></h1>
    <% if policy(PurchaseOrder).create? %>
      <%= link_to t("purchase_orders.new"), new_purchase_order_path,
                  class: "btn-primary" %>
    <% end %>
  </div>

  <%= search_form_for @ransack, url: purchase_orders_path do |f| %>
    <div class="flex gap-3 mb-4">
      <%= f.search_field :po_number_or_supplier_name_cont,
                         placeholder: t("placeholders.purchase_orders.search"),
                         class: "flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <%= f.submit "Search", class: "px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded-md hover:bg-gray-300" %>
      <%= link_to "Clear", purchase_orders_path, class: "px-4 py-2 text-sm text-gray-500 hover:underline" %>
    </div>
  <% end %>

  <div class="overflow-hidden border border-gray-200 rounded-lg">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("purchase_orders.table.po_number") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("purchase_orders.table.supplier") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("purchase_orders.table.date") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("purchase_orders.table.status") %></th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("purchase_orders.table.lines") %></th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("purchase_orders.table.actions") %></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @purchase_orders.each do |po| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-medium text-gray-900">
              <%= link_to po.po_number, purchase_order_path(po), class: "text-blue-600 hover:underline" %>
            </td>
            <td class="px-4 py-3 text-gray-600"><%= po.supplier.name %></td>
            <td class="px-4 py-3 text-gray-600"><%= po.po_date.strftime("%d %b %Y") %></td>
            <td class="px-4 py-3">
              <% case po.status %>
              <% when "Dr" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700"><%= t("purchase_orders.status.draft") %></span>
              <% when "Cf" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800"><%= t("purchase_orders.status.confirmed") %></span>
              <% when "Cc" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700"><%= t("purchase_orders.status.cancelled") %></span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-center text-gray-600">—</td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "View", purchase_order_path(po), class: "row-action-primary" %>
                <% if policy(po).update? && po.draft? %>
                  <%= link_to "Edit", edit_purchase_order_path(po), class: "row-action-primary" %>
                <% end %>
                <% if policy(po).destroy? && po.draft? %>
                  <%= button_to "Delete", purchase_order_path(po), method: :delete,
                                class: "row-action-danger",
                                data: { turbo_confirm: "Delete #{po.po_number}?" } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @purchase_orders.empty? %>
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-gray-400"><%= t("purchase_orders.empty_state") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex items-center justify-between">
    <p class="text-sm text-gray-500">
      Showing <span class="font-medium text-gray-700"><%= @pagy.from %>–<%= @pagy.to %></span>
      of <span class="font-medium text-gray-700"><%= @pagy.count %></span>
    </p>
    <%== @pagy.series_nav if @pagy.pages > 1 %>
  </div>
</div>
