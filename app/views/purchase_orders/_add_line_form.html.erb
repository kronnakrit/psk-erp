<%# Add line form for a draft PO — uses same product typeahead pattern as order lines %>
<%= turbo_frame_tag "add_po_line_frame" do %>
  <%= form_with url: purchase_order_purchase_order_lines_path(purchase_order),
                data: { controller: "po-line-form", turbo_frame: "_top" },
                class: "mt-4 border border-gray-200 rounded-lg p-4 bg-gray-50" do |f| %>
    <h3 class="text-sm font-semibold text-gray-700 mb-3">Add Line</h3>
    <div class="grid grid-cols-1 sm:grid-cols-5 gap-3"
         data-controller="order-line-search"
         data-action="order-line-search:selected->po-line-form#onProductSelected">
      <%# Product typeahead %>
      <div class="sm:col-span-2 relative">
        <label class="block text-xs font-medium text-gray-600 mb-1">Product</label>
        <input type="text"
               name="_product_search"
               placeholder="<%= t('placeholders.purchase_orders.line_product') %>"
               autocomplete="off"
               class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-1 focus:ring-blue-500"
               data-order-line-search-target="input"
               data-action="input->order-line-search#onInput">
        <input type="hidden" name="purchase_order_line[product_id]"
               data-order-line-search-target="productId"
               data-po-line-form-target="productId">
        <div class="hidden bg-white border border-gray-200 rounded-md shadow-lg max-h-48 overflow-y-auto text-sm"
             style="z-index: 9999"
             data-order-line-search-target="dropdown"></div>
      </div>

      <%# Unit definition — populated by Stimulus when product selected %>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Unit</label>
        <select name="purchase_order_line[unit_definition_id]"
                data-po-line-form-target="unitDefinition"
                data-order-line-search-target="unitDefinition"
                class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-1 focus:ring-blue-500">
          <option value="">— select product —</option>
        </select>
      </div>

      <%# Quantity %>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Quantity</label>
        <input type="number" name="purchase_order_line[quantity]" min="0.01" step="0.01"
               value="1"
               class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm text-right focus:outline-none focus:ring-1 focus:ring-blue-500"
               data-po-line-form-target="quantity">
      </div>

      <%# Unit cost — auto-fills via last_purchase_cost API %>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Unit Cost</label>
        <input type="number" name="purchase_order_line[unit_cost]" min="0" step="0.01"
               value="0"
               class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm text-right focus:outline-none focus:ring-1 focus:ring-blue-500"
               data-po-line-form-target="unitCost">
      </div>
    </div>

    <div class="flex justify-end mt-3">
      <%= f.submit "Add Line",
                   class: "px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors cursor-pointer" %>
    </div>
  <% end %>
<% end %>
