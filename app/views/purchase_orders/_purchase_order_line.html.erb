<tr id="purchase_order_line_<%= line.id %>" class="hover:bg-gray-50">
  <td class="px-4 py-3 text-sm text-gray-900 font-medium"><%= line.product.name %></td>
  <td class="px-4 py-3 text-sm text-gray-600"><%= line.product.sku %></td>
  <td class="px-4 py-3 text-sm text-gray-600"><%= line.unit_definition.name %></td>
  <td class="px-4 py-3 text-sm text-right text-gray-700"><%= line.quantity %></td>
  <td class="px-4 py-3 text-sm text-right text-gray-700"><%= number_with_precision(line.unit_cost, precision: 2, delimiter: ",") %></td>
  <td class="px-4 py-3 text-sm text-right font-medium text-gray-900"><%= number_with_precision(line.line_total, precision: 2, delimiter: ",") %></td>

</tr>
