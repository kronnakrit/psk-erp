<% content_for :title, t("invoices.title") %>

<div class="p-6" data-controller="bulk-action">
  <%# Header %>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900" data-testid="page-title"><%= t("invoices.title") %></h1>
    <div class="flex items-center gap-2">
      <% if policy(Invoice).create? %>
        <%= link_to t("invoices.new"), new_invoice_path,
                    class: "btn-primary",
                    data: { testid: "create-invoice-btn" } %>
      <% end %>
    </div>
  </div>

  <%# Status tabs %>
  <div class="flex gap-1 mb-4 border-b border-gray-200" data-testid="status-tabs">
    <%= link_to "All", invoices_path,
                class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px #{ action_name == 'index' ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700' }" %>
    <%= link_to t("invoices.status.draft"),     draft_invoices_path,
                class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px #{ action_name == 'draft'     ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700' }" %>
    <%= link_to t("invoices.status.paid"),      paid_invoices_path,
                class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px #{ action_name == 'paid'      ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700' }" %>
    <%= link_to t("invoices.status.cancelled"), cancelled_invoices_path,
                class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px #{ action_name == 'cancelled' ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700' }" %>
  </div>

  <%# Search – Ransack %>
  <%= search_form_for @ransack, url: invoices_path do |f| %>
    <div class="flex gap-3 mb-4">
      <%= f.search_field :invoice_number_or_customer_first_name_or_customer_last_name_cont,
                         placeholder: t("placeholders.invoices.search"),
                         class: "flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
                         data: { testid: "search-input" } %>
      <%= f.submit "Search", class: "px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded-md hover:bg-gray-300 transition-colors" %>
      <%= link_to "Clear", invoices_path, class: "px-4 py-2 text-sm text-gray-500 hover:underline" %>
    </div>
  <% end %>

  <%# Bulk action bar %>
  <% if policy(Invoice).bulk_update_status? %>
    <div id="bulk_action_bar" class="hidden mb-4 flex items-center gap-3 p-3 bg-yellow-50 border border-yellow-200 rounded-md"
         data-testid="bulk-action-bar">
      <span class="text-sm text-gray-700"><span id="selected_count">0</span> selected</span>
      <%= form_tag bulk_update_status_invoices_path, method: :post, id: "bulk_status_form" do %>
        <select name="status" id="bulk_status_select" class="px-3 py-1.5 border border-gray-300 rounded-md text-sm">
          <option value="Pd">Paid</option>
        </select>
        <%= submit_tag "Update Status", class: "px-3 py-1.5 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 transition-colors" %>
      <% end %>
    </div>
  <% end %>

  <%# Table %>
  <div class="overflow-hidden border border-gray-200 rounded-lg" data-testid="invoices-table">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <% if policy(Invoice).bulk_update_status? %>
            <th class="w-8 px-4 py-3">
              <input type="checkbox" id="select_all_checkbox" class="h-4 w-4 text-blue-600 border-gray-300 rounded">
            </th>
          <% end %>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("invoices.table.no") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("invoices.table.date") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("invoices.table.customer") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("invoices.table.status") %></th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("invoices.table.total_bill") %></th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("invoices.table.actions") %></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @invoices.each do |invoice| %>
          <tr class="hover:bg-gray-50">
            <% if policy(Invoice).bulk_update_status? %>
              <td class="px-4 py-3">
                <input type="checkbox" name="ids[]" value="<%= invoice.id %>"
                       form="bulk_status_form"
                       class="invoice_checkbox h-4 w-4 text-blue-600 border-gray-300 rounded">
              </td>
            <% end %>
            <td class="px-4 py-3 font-mono font-medium text-gray-900" data-testid="invoice-number-cell">
              <%= link_to invoice.invoice_number, invoice_path(invoice),
                          class: "text-blue-600 hover:underline" %>
            </td>
            <td class="px-4 py-3 text-gray-600">
              <%= invoice.invoice_date&.strftime("%d %b %Y") %>
            </td>
            <td class="px-4 py-3 text-gray-800">
              <%= invoice.customer&.fullname %>
            </td>
            <td class="px-4 py-3">
              <%= render "invoices/status_badge", status: invoice.status %>
            </td>
            <td class="px-4 py-3 text-right font-medium text-gray-900">
              <%= number_to_currency(invoice.total_amount, unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "View", invoice_path(invoice),
                            class: "row-action-primary",
                            data: { testid: "view-invoice-#{invoice.id}" } %>
                <%= link_to "Print", print_invoice_path(invoice), target: "_blank",
                            class: "row-action-muted",
                            data: { testid: "print-invoice-#{invoice.id}" } %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @invoices.empty? %>
          <tr>
            <td colspan="<%= policy(Invoice).bulk_update_status? ? 7 : 6 %>"
                class="px-4 py-8 text-center text-gray-400 text-sm">
              <%= t("invoices.empty_state") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Pagination %>
  <% if @pagy.pages > 1 %>
    <div class="mt-4">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
