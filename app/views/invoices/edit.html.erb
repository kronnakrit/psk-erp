<% content_for :title, "Edit Invoice #{@invoice.invoice_number}" %>

<div class="p-4 md:p-6 max-w-2xl">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to invoice_path(@invoice), class: "text-gray-400 hover:text-gray-600" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
    <h1 class="text-xl font-semibold text-gray-900">Edit Invoice <%= @invoice.invoice_number %></h1>
  </div>

  <%= form_with model: @invoice, url: invoice_path(@invoice), method: :patch do |f| %>
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1" for="invoice_remark">Remark</label>
        <%= f.text_area :remark, rows: 4,
                        class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
                        data: { testid: "remark-input" } %>
      </div>
      <div class="flex gap-3 justify-end">
        <%= link_to "Cancel", invoice_path(@invoice),
                    class: "px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200" %>
        <%= f.submit "Save",
                     class: "px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700",
                     data: { testid: "save-remark-btn" } %>
      </div>
    </div>
  <% end %>
</div>
