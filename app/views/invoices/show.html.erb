<% content_for :title, "Invoice #{@invoice.invoice_number}" %>

<div class="p-6" data-testid="invoice-show">

  <%# Header %>
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <div>
        <h1 class="page-heading" data-testid="invoice-number">Invoice <%= @invoice.invoice_number %></h1>
        <p class="text-sm text-gray-500 mt-0.5"><%= @invoice.invoice_date&.strftime("%d %B %Y") %></p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Print Invoice", print_invoice_path(@invoice), target: "_blank",
                  class: "btn-secondary",
                  data: { testid: "print-invoice-btn" } %>

      <% if policy(@invoice).mark_paid? %>
        <%= button_to "Mark as Paid", mark_paid_invoice_path(@invoice), method: :post,
                      class: "btn-primary",
                      data: { testid: "mark-paid-btn", turbo_confirm: "Mark this invoice as Paid?" } %>
      <% end %>

      <% if policy(@invoice).cancel? %>
        <%= button_to "Cancel Invoice", cancel_invoice_path(@invoice), method: :post,
                      class: "btn-danger",
                      data: { testid: "cancel-invoice-btn", turbo_confirm: "Cancel this invoice? This cannot be undone." } %>
      <% end %>

      <% if policy(@invoice).reopen? %>
        <%= button_to "Reopen to Draft", reopen_invoice_path(@invoice), method: :post,
                      class: "btn-secondary",
                      data: { testid: "reopen-btn", turbo_confirm: "Reopen this invoice to Draft?" } %>
      <% end %>

      <% if policy(@invoice).update? && @invoice.status == "Dr" %>
        <%= link_to "Edit Remark", edit_invoice_path(@invoice),
                    class: "btn-outline",
                    data: { testid: "edit-remark-btn" } %>
      <% end %>
    </div>
  </div>

  <%# Invoice Details card %>
  <div class="bg-white border border-gray-200 rounded-lg p-5 mb-6" data-testid="invoice-details-card">
    <h2 class="section-heading mb-4"><%= t("invoices.show.invoice_details") %></h2>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
      <div>
        <dt class="text-xs text-gray-500 font-medium"><%= t("invoices.show.invoice_no") %></dt>
        <dd class="mt-0.5 font-mono font-medium text-gray-900" data-testid="invoice-number-detail"><%= @invoice.invoice_number %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 font-medium"><%= t("invoices.show.invoice_date") %></dt>
        <dd class="mt-0.5 text-gray-800"><%= @invoice.invoice_date&.strftime("%d %b %Y") %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 font-medium"><%= t("invoices.show.customer") %></dt>
        <dd class="mt-0.5 text-gray-800" data-testid="customer-name"><%= @invoice.customer&.fullname %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 font-medium"><%= t("invoices.show.status") %></dt>
        <dd class="mt-0.5"><%= render "invoices/status_badge", status: @invoice.status %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 font-medium"><%= t("invoices.show.total_amount") %></dt>
        <dd class="mt-0.5 font-semibold text-gray-900">
          <%= number_to_currency(@invoice.total_amount, unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 font-medium"><%= t("invoices.show.remark") %></dt>
        <dd class="mt-0.5 text-gray-800"><%= @invoice.remark.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 font-medium"><%= t("invoices.show.created_by") %></dt>
        <dd class="mt-0.5 text-gray-800" data-testid="created-by">
          <%= @invoice.created_by&.profile&.full_name.presence || @invoice.created_by&.email || "—" %>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 font-medium"><%= t("invoices.show.last_updated_by") %></dt>
        <dd class="mt-0.5 text-gray-800">
          <%= @invoice.updated_by&.profile&.full_name.presence || @invoice.updated_by&.email || "—" %>
        </dd>
      </div>
    </dl>
  </div>

  <%# Associated Orders %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6" data-testid="associated-orders">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
      <h2 class="section-heading"><%= t("invoices.show.associated_orders") %></h2>
      <% if policy(@invoice).update? && @invoice.status == "Dr" %>
        <%= link_to t("invoices.show.add_orders"), add_orders_invoice_path(@invoice),
                    class: "text-xs px-3 py-1.5 bg-blue-600 text-white rounded-md hover:bg-blue-700",
                    data: { testid: "add-orders-btn" } %>
      <% end %>
    </div>
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="w-8 px-3 py-3"></th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase w-10"><%= t("orders.table.no") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("invoices.table.order_no") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("invoices.table.date") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("invoices.table.customer") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("invoices.table.status") %></th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase"><%= t("invoices.table.grand_total") %></th>
          <% if policy(@invoice).update? && @invoice.status == "Dr" %>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
          <% end %>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @associated_orders.each_with_index do |order, index| %>
          <%
            gt        = GrandTotalCalculator.new(order).call
            detail_id = "order-lines-#{order.id}"
          %>
          <%# Main order row — clicking the chevron toggles the detail panel %>
          <tr class="hover:bg-gray-50 cursor-pointer"
              onclick="document.getElementById('<%= detail_id %>').classList.toggle('hidden')"
              data-testid="order-row-<%= order.id %>">
            <td class="px-3 py-3 text-gray-400">
              <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </td>
            <td class="px-4 py-3 text-center text-gray-500"><%= index + 1 %></td>
            <td class="px-4 py-3 font-mono font-medium">
              <%= link_to order.order_number, order_path(order),
                          class: "text-blue-600 hover:underline",
                          onclick: "event.stopPropagation()" %>
            </td>
            <td class="px-4 py-3 text-gray-600"><%= order.running_date&.strftime("%d %b %Y") %></td>
            <td class="px-4 py-3 text-gray-800"><%= order.customer&.fullname %></td>
            <td class="px-4 py-3"><%= render "orders/status_badge", status: order.status %></td>
            <td class="px-4 py-3 text-right font-medium text-gray-900">
              <%= number_to_currency(order.grand_total, unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %>
            </td>
            <% if policy(@invoice).update? && @invoice.status == "Dr" %>
              <td class="px-4 py-3 text-right" onclick="event.stopPropagation()">
                <%= button_to "Remove", invoice_invoice_order_path(@invoice, order),
                              method: :delete,
                              class: "text-xs text-red-600 hover:underline",
                              data: { turbo_method: "delete", turbo_confirm: "Remove this order from the invoice?",
                                      testid: "remove-order-#{order.id}" } %>
              </td>
            <% end %>
          </tr>

          <%# Collapsible detail row — hidden by default %>
          <tr id="<%= detail_id %>" class="hidden bg-gray-50">
            <td colspan="<%= policy(@invoice).update? && @invoice.status == 'Dr' ? 7 : 6 %>" class="px-6 py-4">
              <%# Order lines table %>
              <table class="w-full text-xs mb-3">
                <thead>
                  <tr class="border-b border-gray-200">
                    <th class="pb-2 text-left font-medium text-gray-500 uppercase"><%= t("orders.table.product") %></th>
                    <th class="pb-2 text-left font-medium text-gray-500 uppercase"><%= t("orders.table.unit") %></th>
                    <th class="pb-2 text-right font-medium text-gray-500 uppercase"><%= t("orders.table.quantity") %></th>
                    <th class="pb-2 text-right font-medium text-gray-500 uppercase"><%= t("orders.table.unit_price") %></th>
                    <th class="pb-2 text-right font-medium text-gray-500 uppercase"><%= t("orders.table.discount") %></th>
                    <th class="pb-2 text-right font-medium text-gray-500 uppercase"><%= t("invoices.table.line_total") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% order.order_lines.each do |line| %>
                    <tr class="border-b border-gray-100">
                      <td class="py-1.5 pr-3 text-gray-800"><%= line.product&.name || "—" %></td>
                      <td class="py-1.5 pr-3 text-gray-600"><%= line.unit_definition&.name || "—" %></td>
                      <td class="py-1.5 pr-3 text-right text-gray-700"><%= line.quantity %></td>
                      <td class="py-1.5 pr-3 text-right text-gray-700">
                        <%= number_to_currency(line.unit_price, unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %>
                      </td>
                      <td class="py-1.5 pr-3 text-right text-red-600">
                        <% if line.discount_price.to_d.nonzero? %>
                          − <%= number_to_currency(line.discount_price, unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %>
                        <% else %>
                          —
                        <% end %>
                      </td>
                      <td class="py-1.5 text-right text-gray-900 font-medium">
                        <%= number_to_currency(line.total_price, unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %>
                      </td>
                    </tr>
                  <% end %>
                  <% if order.order_lines.empty? %>
                    <tr>
                      <td colspan="6" class="py-3 text-center text-gray-400">No line items.</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>

              <%# Per-order mini-summary %>
              <div class="flex justify-end">
                <div class="text-xs space-y-1" style="min-width: 260px;">
                  <div class="flex justify-between text-gray-600 gap-8">
                    <span>Subtotal</span>
                    <span><%= number_to_currency(gt[:total_price], unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %></span>
                  </div>
                  <% if gt[:discount_amount].nonzero? %>
                    <div class="flex justify-between text-gray-600 gap-8">
                      <span>Discount</span>
                      <span class="text-red-600">− <%= number_to_currency(gt[:discount_amount], unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %></span>
                    </div>
                    <div class="flex justify-between text-gray-600 gap-8">
                      <span>After Discount</span>
                      <span><%= number_to_currency(gt[:price_with_discount], unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %></span>
                    </div>
                  <% end %>
                  <% if order.has_vat? %>
                    <div class="flex justify-between text-gray-600 gap-8">
                      <span>VAT (7%)</span>
                      <span><%= number_to_currency(gt[:vat_price], unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %></span>
                    </div>
                  <% end %>
                  <% if order.is_withholding_tax? && gt[:withholding_tax_amount].nonzero? %>
                    <div class="flex justify-between text-gray-600 gap-8">
                      <span>Withholding Tax (<%= order.withholding_tax %>%)</span>
                      <span class="text-red-600">− <%= number_to_currency(gt[:withholding_tax_amount], unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %></span>
                    </div>
                  <% end %>
                  <div class="flex justify-between font-semibold text-gray-900 pt-1.5 border-t border-gray-200 gap-8">
                    <span>Grand Total</span>
                    <span><%= number_to_currency(gt[:grand_total], unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %></span>
                  </div>
                </div>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @associated_orders.empty? %>
          <tr>
            <td colspan="6" class="px-4 py-6 text-center text-gray-400 text-sm">No orders associated.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Associated Orders Summary %>
  <% if @associated_orders.any? %>
    <%
      order_summaries = @associated_orders.map { |o| GrandTotalCalculator.new(o).call }
      agg_subtotal       = order_summaries.sum { |s| s[:total_price] }
      agg_discount       = order_summaries.sum { |s| s[:discount_amount] }
      agg_after_discount = order_summaries.sum { |s| s[:price_with_discount] }
      agg_vat            = order_summaries.sum { |s| s[:vat_price] }
      agg_wht            = order_summaries.sum { |s| s[:withholding_tax_amount] }
      agg_grand_total    = order_summaries.sum { |s| s[:grand_total] }
      any_vat            = @associated_orders.any?(&:has_vat?)
      any_wht            = @associated_orders.any?(&:is_withholding_tax?)
    %>
    <div class="flex justify-end mb-6" data-testid="invoice-summary">
      <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-2 text-sm" style="min-width: 320px;">
        <h2 class="section-heading mb-3"><%= t("invoices.show.summary") %></h2>

        <div class="flex justify-between text-gray-600">
          <span><%= t("common.summary.subtotal") %></span>
          <span><%= number_to_currency(agg_subtotal, unit: "฿", precision: 2) %></span>
        </div>

        <% if agg_discount.nonzero? %>
          <div class="flex justify-between text-gray-600">
            <span><%= t("common.summary.discount") %></span>
            <span class="text-red-600">− <%= number_to_currency(agg_discount, unit: "฿", precision: 2) %></span>
          </div>
          <div class="flex justify-between text-gray-600">
            <span><%= t("common.summary.after_discount") %></span>
            <span><%= number_to_currency(agg_after_discount, unit: "฿", precision: 2) %></span>
          </div>
        <% end %>

        <% if any_vat %>
          <div class="flex justify-between text-gray-600">
            <span><%= t("common.summary.vat") %></span>
            <span><%= number_to_currency(agg_vat, unit: "฿", precision: 2) %></span>
          </div>
        <% end %>

        <% if any_wht && agg_wht.nonzero? %>
          <div class="flex justify-between text-gray-600">
            <span><%= t("common.summary.withholding_tax") %></span>
            <span class="text-red-600">− <%= number_to_currency(agg_wht, unit: "฿", precision: 2) %></span>
          </div>
        <% end %>

        <div class="flex justify-between items-center font-semibold text-gray-900 pt-3 border-t border-gray-200 mt-3 gap-12">
          <span>Grand Total</span>
          <span class="text-lg"><%= number_to_currency(agg_grand_total, unit: "฿", precision: 2) %></span>
        </div>
      </div>
    </div>
  <% end %>

  <%# Images %>
  <div class="mt-6 bg-white border border-gray-200 rounded-lg p-5 mb-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="section-heading"><%= t("invoices.show.images") %></h2>
    </div>
    <div id="invoice_images" class="flex flex-wrap gap-3">
      <% @invoice_images.each do |ii| %>
        <%= render "invoice_images/invoice_image", invoice_image: ii %>
      <% end %>
    </div>
    <% if policy(@invoice).update? %>
      <div class="mt-4 pt-4 border-t border-gray-100">
        <%= form_with url: invoice_invoice_images_path(@invoice), scope: :invoice_image, multipart: true do |f| %>
          <div class="flex items-center gap-3">
            <%= f.file_field :image, accept: "image/*",
                             class: "text-sm text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
            <%= f.submit "Upload",
                         class: "px-3 py-1.5 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 transition-colors" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Change History — lazy-loaded via Turbo Frame %>
  <% if policy(@invoice).audit? %>
    <div class="mt-6 bg-white border border-gray-200 rounded-lg p-5">
      <h2 class="section-heading mb-4"><%= t("invoices.show.change_history") %></h2>
      <%= turbo_frame_tag "invoice_audit_trail",
                          src: audit_trail_invoice_path(@invoice),
                          loading: "lazy" do %>
        <div class="space-y-3 animate-pulse">
          <div class="h-4 bg-gray-200 rounded w-3/4"></div>
          <div class="h-4 bg-gray-200 rounded w-1/2"></div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
