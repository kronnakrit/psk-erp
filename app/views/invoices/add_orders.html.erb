<% content_for :title, "Add Orders to Invoice #{@invoice.invoice_number}" %>

<div class="p-4 md:p-6" data-testid="add-orders-page">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to invoice_path(@invoice), class: "text-gray-400 hover:text-gray-600" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-gray-900">Add Orders to Invoice <%= @invoice.invoice_number %></h1>
      <p class="text-sm text-gray-500 mt-0.5">Customer: <strong><%= @invoice.customer&.fullname %></strong></p>
    </div>
  </div>

  <%= form_tag invoice_invoice_orders_path(@invoice), method: :post do %>
    <div class="overflow-hidden border border-gray-200 rounded-lg mb-4">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="w-8 px-4 py-3">
              <input type="checkbox" id="select_all_checkbox" class="h-4 w-4 text-blue-600 border-gray-300 rounded">
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Order #</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Grand Total</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @eligible_orders.each do |order| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3">
                <input type="checkbox" name="order_ids[]" value="<%= order.id %>"
                       class="h-4 w-4 text-blue-600 border-gray-300 rounded"
                       data-testid="add-order-checkbox-<%= order.id %>">
              </td>
              <td class="px-4 py-3 font-mono font-medium text-gray-900"><%= order.order_number %></td>
              <td class="px-4 py-3 text-gray-600"><%= order.running_date&.strftime("%d %b %Y") %></td>
              <td class="px-4 py-3 text-gray-800"><%= order.customer&.fullname %></td>
              <td class="px-4 py-3"><%= render "orders/status_badge", status: order.status %></td>
              <td class="px-4 py-3 text-right font-medium text-gray-900">
                <%= number_to_currency(order.grand_total, unit: "฿", separator: ".", delimiter: ",", format: "%u%n") %>
              </td>
            </tr>
          <% end %>
          <% if @eligible_orders.empty? %>
            <tr>
              <td colspan="6" class="px-4 py-8 text-center text-gray-400 text-sm">
                No eligible orders for this customer.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% unless @eligible_orders.empty? %>
      <div class="flex gap-3 justify-end">
        <%= link_to "Cancel", invoice_path(@invoice),
                    class: "px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200" %>
        <%= submit_tag "Add Selected Orders",
                       class: "px-6 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700",
                       data: { testid: "add-orders-submit-btn" } %>
      </div>
    <% end %>
  <% end %>
</div>
