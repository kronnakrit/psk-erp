<%= turbo_frame_tag "invoice_audit_trail" do %>
  <% if audits.empty? %>
    <p class="text-sm text-gray-500 py-4">No changes recorded yet.</p>
  <% else %>
    <ol class="relative border-l border-gray-200 ml-3 space-y-6">
      <% audits.each do |audit| %>
        <li class="ml-6">
          <span class="absolute -left-3 flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 ring-2 ring-white text-xs font-semibold text-blue-700">
            <%= invoice_audit_initials(audit) %>
          </span>
          <div class="flex items-baseline gap-2 mb-0.5 pl-5">
            <span class="text-sm font-medium text-gray-900"><%= invoice_audit_actor_name(audit) %></span>
            <time class="text-xs text-gray-400"
                  title="<%= audit.changed_at.strftime('%d %b %Y %H:%M:%S') %>">
              <%= time_ago_in_words(audit.changed_at) %> ago
            </time>
          </div>
          <p class="text-sm text-gray-700"><%= invoice_audit_description(audit) %></p>
        </li>
      <% end %>
    </ol>
  <% end %>
<% end %>
