<% content_for :title, @country.new_record? ? "New Country" : "Edit Country" %>

<div class="p-6 max-w-2xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900">
      <%= @country.new_record? ? "New Country" : "Edit Country — #{@country.printable_name}" %>
    </h1>
    <%= link_to "← Back to Countries", countries_path, class: "text-sm text-blue-600 hover:underline" %>
  </div>

  <%= form_with model: @country, class: "space-y-6" do |f| %>
    <% if @country.errors.any? %>
      <div class="p-4 bg-red-50 border border-red-200 rounded-md">
        <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
          <% @country.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
      <div>
        <%= f.label :iso_3166_1_a2, "Alpha-2 Code (PK)", class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :iso_3166_1_a2,
                         maxlength: 2,
                         disabled: @country.persisted?,
                         class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:bg-gray-100" %>
      </div>

      <div>
        <%= f.label :iso_3166_1_a3, "Alpha-3 Code", class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :iso_3166_1_a3,
                         maxlength: 3,
                         class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :iso_3166_1_numeric, "Numeric Code", class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :iso_3166_1_numeric,
                         maxlength: 3,
                         class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :printable_name, "Printable Name", class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :printable_name,
                         class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :name, "Official Name (uppercase)", class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name,
                         class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="flex gap-3">
      <%= f.submit @country.new_record? ? "Create Country" : "Update Country",
                  class: "px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 cursor-pointer" %>
      <%= link_to "Cancel", countries_path, class: "px-5 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
