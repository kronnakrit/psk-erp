<section class="mt-8 bg-white border border-gray-200 rounded-lg p-5">
  <h2 class="text-sm font-semibold text-gray-700 mb-4">Price Anomaly Monitor</h2>

  <% if price_alerts.empty? %>
    <p class="text-sm text-gray-500">No price anomalies detected in the past 365 days.</p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Product</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">First Price</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Current Price</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Change (%)</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">First Order #</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Latest Order #</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% price_alerts.each do |alert| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-gray-900"><%= alert.customer&.fullname %></td>
              <td class="px-4 py-3 text-gray-900">
                <span class="font-mono text-xs text-gray-500"><%= alert.product&.sku %></span>
                — <%= alert.product&.name %>
              </td>
              <td class="px-4 py-3 text-right text-gray-700">
                ฿<%= number_with_precision(alert.first_price, precision: 2, delimiter: ",") %>
              </td>
              <td class="px-4 py-3 text-right text-gray-700">
                ฿<%= number_with_precision(alert.last_price, precision: 2, delimiter: ",") %>
              </td>
              <td class="px-4 py-3 text-right font-medium <%= alert.change_pct.negative? ? 'text-red-600' : 'text-green-600' %>">
                <%= alert.change_pct.positive? ? "+" : "" %><%= number_with_precision(alert.change_pct, precision: 2) %>%
              </td>
              <td class="px-4 py-3 font-mono text-gray-700"><%= alert.first_order_number %></td>
              <td class="px-4 py-3 font-mono text-gray-700"><%= alert.last_order_number %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
