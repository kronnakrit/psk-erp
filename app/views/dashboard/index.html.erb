<% content_for :title, "Dashboard" %>

<div class="p-6">
  <%# Page header %>
  <div class="mb-6">
    <h1 class="text-xl font-semibold text-gray-900">Dashboard</h1>
    <p class="text-sm text-gray-500 mt-1">
      Welcome back<% if current_user.profile&.full_name.present? %>, <strong><%= current_user.profile.full_name %></strong><% end %>!
    </p>
  </div>

  <%# Stats cards %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Users</p>
      <p class="text-2xl font-bold text-gray-900 mt-1"><%= User.count %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Roles</p>
      <p class="text-2xl font-bold text-gray-900 mt-1"><%= Role.count %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Active Users</p>
      <p class="text-2xl font-bold text-green-600 mt-1"><%= User.where(is_active: true).count %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Inactive Users</p>
      <p class="text-2xl font-bold text-red-500 mt-1"><%= User.where(is_active: false).count %></p>
    </div>
  </div>

  <%# Quick links %>
  <div class="bg-white border border-gray-200 rounded-lg p-5 mb-6">
    <h2 class="text-sm font-semibold text-gray-700 mb-4">Quick Links</h2>
    <div class="flex flex-wrap gap-3">
      <% if permission?("view_users") %>
        <%= link_to t("dashboard.manage_users"), users_path,
                    class: "btn-secondary" %>
      <% end %>
      <% if permission?("view_roles") %>
        <%= link_to t("dashboard.manage_roles"), roles_path,
                    class: "btn-secondary" %>
      <% end %>
      <%= link_to t("dashboard.my_profile"), profile_path,
                  class: "btn-secondary" %>
    </div>
  </div>

  <%# Sales graph — only visible with see_sale_graph permission %>
  <% if permission?("see_sale_graph") && @chart_data %>
    <div class="bg-white border border-gray-200 rounded-lg p-5 mb-6">
      <h2 class="text-sm font-semibold text-gray-700 mb-4">Monthly Revenue (Completed Orders)</h2>
      <div style="height: 300px; position: relative;">
        <canvas id="revenueChart"></canvas>
      </div>
      <script nonce="<%= content_security_policy_nonce %>">
        (function() {
          var chartData = <%= json_escape(@chart_data.to_json) %>;
          var labels = Object.keys(chartData);
          var values = Object.values(chartData);
          function initChart() {
            if (typeof Chart === 'undefined') { return; }
            var ctx = document.getElementById('revenueChart');
            if (!ctx) { return; }
            new Chart(ctx, {
              type: 'bar',
              data: {
                labels: labels,
                datasets: [{ label: 'Revenue (฿)', data: values, backgroundColor: '#2563eb', borderRadius: 4 }]
              },
              options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { ticks: { callback: function(v) { return '฿' + v.toLocaleString(); } } } }
              }
            });
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initChart);
          } else {
            initChart();
          }
        })();
      </script>
    </div>
  <% end %>

  <%# Price Anomaly Monitor — visible to users with see_price_monitor permission %>
  <% if policy(Order).price_monitor? %>
    <%= render "dashboard/price_monitor", price_alerts: @price_alerts %>
  <% end %>

  <%# Reports section — only visible with see_sale_graph permission %>
  <% if permission?("see_sale_graph") %>
    <div class="mt-8 bg-white border border-gray-200 rounded-lg p-5">
      <h2 class="text-sm font-semibold text-gray-700 mb-4">Reports</h2>
      <%= form_tag "#", method: :post, id: "report_form", class: "flex flex-wrap items-end gap-4" do %>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Start Date</label>
          <input type="date" name="start_date" id="report_start_date"
                 value="<%= Time.zone.today.beginning_of_month.strftime('%Y-%m-%d') %>"
                 class="px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">End Date</label>
          <input type="date" name="end_date" id="report_end_date"
                 value="<%= Time.zone.today.strftime('%Y-%m-%d') %>"
                 class="px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <button type="button"
                onclick="downloadReport('<%= customer_report_api_v1_orders_path %>', 'customer_report')"
                class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors">
          Customer Report
        </button>
        <button type="button"
                onclick="downloadReport('<%= sales_report_api_v1_orders_path %>', 'sales_report')"
                class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors">
          Sales Report
        </button>
      <% end %>
    </div>
  <% end %>

  <script nonce="<%= content_security_policy_nonce %>">
    function downloadReport(url, name) {
      const start = document.getElementById('report_start_date').value;
      const end   = document.getElementById('report_end_date').value;
      const form  = document.createElement('form');
      form.method = 'POST';
      form.action = url;
      const csrfMeta = document.querySelector('meta[name="csrf-token"]');
      if (csrfMeta) {
        const csrf = document.createElement('input');
        csrf.type = 'hidden'; csrf.name = 'authenticity_token'; csrf.value = csrfMeta.content;
        form.appendChild(csrf);
      }
      [['start_date', start], ['end_date', end]].forEach(([n, v]) => {
        const f = document.createElement('input'); f.type = 'hidden'; f.name = n; f.value = v;
        form.appendChild(f);
      });
      document.body.appendChild(form);
      form.submit();
      document.body.removeChild(form);
    }
  </script>
</div>
