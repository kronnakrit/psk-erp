<% content_for :title, "Edit Attribute" %>
<div class="p-6 max-w-lg">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to product_class_attributes_path(@product_class), class: "text-gray-400 hover:text-gray-600" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
    <h1 class="text-xl font-semibold text-gray-900">Edit Attribute — <%= @attribute.name %></h1>
  </div>
  <div class="bg-white rounded-lg border border-gray-200 p-6">
    <%= form_with model: [@product_class, @attribute] do |f| %>
      <%= render "form", f: f %>
    <% end %>
  </div>
</div>
