<% content_for :title, "My Profile" %>

<div class="p-6 max-w-xl">
  <h1 class="text-xl font-semibold text-gray-900 mb-6">My Profile</h1>

  <%= form_with model: @profile, url: profile_path, method: :patch, class: "space-y-4" do |f| %>
    <% if @profile.errors.any? %>
      <div class="p-4 bg-red-50 border border-red-200 rounded-md">
        <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
          <% @profile.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_field :first_name, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm" %>
        </div>
        <div>
          <%= f.label :last_name, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_field :last_name, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm" %>
        </div>
      </div>
      <div>
        <%= f.label :telephone, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :telephone, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm" %>
      </div>
      <div>
        <%= f.label :address, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_area :address, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm" %>
      </div>
      <div>
        <%= f.label :remark, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_area :remark, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm" %>
      </div>
    </div>

    <div>
      <%= f.submit "Save Profile", class: "px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 cursor-pointer" %>
    </div>
  <% end %>
</div>
